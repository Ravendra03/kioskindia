{%- comment -%}
  MAXWELL HERO SECTION — ULTRA PREMIUM ENTERPRISE EDITION
{%- endcomment -%}

{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign trust_blocks = section.blocks | where: 'type', 'trust_badge'
-%}

<section
  class="hero-section"
  id="hero"
  aria-label="{{ section.settings.heading }}"
  style="--hero-min-height: {{ section.settings.min_height | default: 90 }}vh; --hero-overlay-opacity: {{ section.settings.overlay_opacity | default: 80 | divided_by: 100.0 }};"
>
  {%- comment -%} Background Image or Mesh Gradient {%- endcomment -%}
  <div class="hero__bg-wrap" aria-hidden="true">
    {%- if section.settings.bg_image != blank -%}
      {{
        section.settings.bg_image
        | image_url: width: 2560
        | image_tag:
          class: 'hero__bg-image',
          alt: section.settings.heading,
          loading: 'eager',
          fetchpriority: 'high',
          width: 2560
      }}
    {%- else -%}
      <div class="hero__bg-mesh"></div>
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__container">
    <div class="hero__grid">

      {%- comment -%} Left Column: Main Headline & CTAs {%- endcomment -%}
      <div class="hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow eyebrow--light" data-animate="fade-up">
            <span class="eyebrow__dot" aria-hidden="true"></span>
            {{ section.settings.eyebrow }}
          </div>
        {%- endif -%}

        <h1 class="hero__heading" data-animate="fade-up" data-delay="100" data-hero-headline>
          {{ section.settings.heading }}
        </h1>

        {%- if section.settings.subheading != blank -%}
          <p class="hero__subheading" data-animate="fade-up" data-delay="200">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}

        <div class="hero__ctas" data-animate="fade-up" data-delay="300">
          {%- if section.settings.cta_primary_text != blank -%}
            <a
              href="{{ section.settings.cta_primary_url | default: '/collections/all' }}"
              class="btn btn--accent btn--lg hero__btn-primary"
              id="hero-primary-cta"
            >
              {{ section.settings.cta_primary_text }}
              <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 20 %}</span>
            </a>
          {%- endif -%}

          {%- if section.settings.cta_secondary_text != blank -%}
            <a
              href="{{ section.settings.cta_secondary_url | default: '/pages/contact' }}"
              class="btn btn--secondary btn--lg hero__btn-secondary"
              id="hero-secondary-cta"
            >
              {{ section.settings.cta_secondary_text }}
            </a>
          {%- endif -%}

          {%- if settings.contact_phone != blank -%}
            <a
              href="tel:{{ settings.contact_phone_raw }}"
              class="btn btn--ghost hero__hotline"
              aria-label="Call B2B Sales Direct Hotline"
            >
              <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'phone', size: 18 %}</span>
              <span>Direct Sales: {{ settings.contact_phone }}</span>
            </a>
          {%- endif -%}
        </div>

        {%- comment -%} Trust Badges Strip {%- endcomment -%}
        {%- if section.settings.show_trust_badges and trust_blocks.size > 0 -%}
          <div class="hero__trust" data-animate="fade-up" data-delay="400">
            {%- for block in trust_blocks -%}
              <div class="hero__trust-item" {{ block.shopify_attributes }}>
                {% render 'icon', name: block.settings.icon, size: 16 %}
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right Column: Product Hero Stage Card {%- endcomment -%}
      <div class="hero__product-col" data-animate="fade-left" data-delay="300">
        <div class="product-hero-card">
          <div class="product-hero-card__badge-wrap">
            <span class="product-hero-card__tag">Flagship Hardware</span>
            <span class="product-hero-card__rating">
              <span class="star">★</span> 4.9 (120+ B2B Deployments)
            </span>
          </div>

          <div class="product-hero-card__stage">
            {%- if section.settings.product_image != blank -%}
              {{
                section.settings.product_image
                | image_url: width: 800
                | image_tag:
                  class: 'product-hero-card__image',
                  alt: section.settings.product_title | default: 'Interactive Kiosk Pro',
                  loading: 'eager',
                  fetchpriority: 'high',
                  width: 800
              }}
            {%- else -%}
              <div class="product-hero-card__placeholder">
                <svg width="120" height="180" viewBox="0 0 120 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="10" y="10" width="100" height="160" rx="12" fill="#062B49" stroke="#0866D6" stroke-width="3"/>
                  <rect x="20" y="25" width="80" height="110" rx="6" fill="#031C2F" stroke="rgba(255,255,255,0.2)"/>
                  <circle cx="60" cy="152" r="6" fill="#F28C28"/>
                  <path d="M35 55L85 55M35 75L70 75M35 95L60 95" stroke="#0866D6" stroke-width="3" stroke-linecap="round"/>
                </svg>
              </div>
            {%- endif -%}

            <div class="product-hero-card__floating-spec">
              <span class="spec-icon">⚡</span>
              <span>IP65 Weatherproof Steel</span>
            </div>
          </div>

          <div class="product-hero-card__body">
            <h3 class="product-hero-card__title">
              {{ section.settings.product_title | default: 'Interactive Touch Kiosk Pro 55"' }}
            </h3>
            <p class="product-hero-card__desc">
              Custom dual-screen self-service terminal with thermal printer, POS reader, and scanner.
            </p>

            <div class="product-hero-card__specs-row">
              <span class="tech-spec-pill">55" 4K Capacitive</span>
              <span class="tech-spec-pill">Heavy Sheet Metal</span>
              <span class="tech-spec-pill">Windows / Android</span>
            </div>

            <a
              href="{{ section.settings.product_cta_url | default: '/collections/all' }}"
              class="btn btn--primary btn--sm product-hero-card__cta"
            >
              {{ section.settings.product_cta_text | default: 'View Product Specifications' }}
              {% render 'icon', name: 'arrow-right', size: 16 %}
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>

  {%- comment -%} Product Lines Quick-Switch Strip ───────────────────────────────── {%- endcomment -%}
  <div class="hero__product-strip" data-animate="fade-up" data-delay="500">
    <div class="container">
      <div class="product-strip__grid">
        <a href="/collections/interactive-kiosks" class="product-strip__item">
          <div class="product-strip__icon">{% render 'icon', name: 'monitor', size: 20 %}</div>
          <div class="product-strip__meta">
            <span class="product-strip__title">Interactive Kiosks</span>
            <span class="product-strip__sub">Self-Service & Payment</span>
          </div>
        </a>

        <a href="/collections/digital-signages" class="product-strip__item">
          <div class="product-strip__icon">{% render 'icon', name: 'grid', size: 20 %}</div>
          <div class="product-strip__meta">
            <span class="product-strip__title">Digital Signages</span>
            <span class="product-strip__sub">Indoor & Outdoor Totems</span>
          </div>
        </a>

        <a href="/collections/ip65-enclosures" class="product-strip__item">
          <div class="product-strip__icon">{% render 'icon', name: 'shield', size: 20 %}</div>
          <div class="product-strip__meta">
            <span class="product-strip__title">IP65 Enclosures</span>
            <span class="product-strip__sub">Weatherproof Metal</span>
          </div>
        </a>

        <a href="/collections/smart-lockers" class="product-strip__item">
          <div class="product-strip__icon">{% render 'icon', name: 'package', size: 20 %}</div>
          <div class="product-strip__meta">
            <span class="product-strip__title">Smart Lockers</span>
            <span class="product-strip__sub">Automated Storage</span>
          </div>
        </a>
      </div>
    </div>
  </div>

</section>

<style>
  .hero-section {
    position: relative;
    min-height: auto;
    display: flex;
    align-items: center;
    color: var(--color-text-secondary, #ffffff);
    background-color: var(--color-surface-base, #000000);
    margin-top: 0;
    padding-top: 0;
    padding-bottom: var(--space-8, 20px);
    overflow: hidden;
  }

  .hero__bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__bg-mesh {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 20% 20%, rgba(224, 165, 128, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(23, 23, 23, 0.95) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, #000000 0%, #171717 100%);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.92) 0%, rgba(23, 23, 23, 0.88) 100%);
  }

  .hero__container {
    position: relative;
    z-index: 1;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-12);
    align-items: flex-start;
  }

  .eyebrow__dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-accent);
  }

  .hero__heading {
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .hero__subheading {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.85);
    line-height: var(--leading-relaxed);
    max-width: 620px;
    margin-bottom: var(--space-8);
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .hero__trust {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .hero__trust-item .icon {
    color: var(--color-accent);
  }

  /* Product Hero Stage Styling */
  .hero__product-col {
    display: flex;
    justify-content: flex-end;
  }

  .product-hero-card {
    background: #FFFFFF;
    border-radius: var(--radius-xl, 20px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: var(--space-4);
    width: 100%;
    max-width: 420px;
    box-shadow: 0 20px 40px rgba(3, 28, 47, 0.4);
    color: var(--color-text-primary, #10202F);
    position: relative;
  }

  .product-hero-card__badge-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .product-hero-card__tag {
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    background-color: rgba(8, 102, 214, 0.1);
    color: var(--color-blue-primary, #0866D6);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .product-hero-card__rating {
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
  }

  .product-hero-card__rating .star {
    color: #F59E0B;
  }

  .product-hero-card__stage {
    position: relative;
    background: radial-gradient(circle at 50% 50%, #F7F9FB 0%, #EEF2F5 100%);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-4);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
    border: 1px solid var(--color-border, #DDE4EA);
    overflow: hidden;
  }

  .product-hero-card__image {
    max-height: 100%;
    object-fit: contain;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .product-hero-card:hover .product-hero-card__image {
    transform: scale(1.05);
  }

  .product-hero-card__floating-spec {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: rgba(6, 43, 73, 0.9);
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: var(--font-weight-semibold);
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    gap: 4px;
    backdrop-filter: blur(8px);
  }

  .product-hero-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .product-hero-card__title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.25;
  }

  .product-hero-card__desc {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .product-hero-card__specs-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-block: 4px;
  }

  .product-hero-card__cta {
    width: 100%;
    margin-top: 4px;
  }

  /* Product Strip Below Hero */
  .hero__product-strip {
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    background: rgba(3, 28, 47, 0.7);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .product-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  .product-strip__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md, 12px);
    color: #FFFFFF;
    transition: transform var(--transition), background-color var(--transition), border-color var(--transition);
  }

  .product-strip__item:hover {
    background: rgba(8, 102, 214, 0.2);
    border-color: var(--color-blue-primary, #0866D6);
    transform: translateY(-2px);
  }

  .product-strip__icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-blue-primary, #0866D6);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .product-strip__meta {
    display: flex;
    flex-direction: column;
  }

  .product-strip__title {
    font-size: 0.88rem;
    font-weight: var(--font-weight-bold);
    color: #FFFFFF;
    line-height: 1.2;
  }

  .product-strip__sub {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.65);
  }

  @media (max-width: 991px) {
    .product-strip__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 575px) {
    .product-strip__grid {
      grid-template-columns: 1fr;
    }
  }

  .hero__stats-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero__stats-card-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-hover));
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-glow);
  }

  .hero__stats-card-meta {
    display: flex;
    flex-direction: column;
  }

  .hero__stats-card-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
  }

  .hero__stats-card-sub {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero__stat-number {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1;
  }

  .hero__stat-label {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .hero__stats-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition);
  }

  .hero__stats-cta:hover {
    color: var(--color-white);
  }

  .hero__scroll {
    display: none;
  }

  @media (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .hero__stats-col {
      justify-content: start;
    }
    .hero__stats-card {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__btn-primary, .hero__btn-secondary {
      width: 100%;
    }
    .hero__stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Premium Manufacturer · Ahmedabad, India"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main headline",
      "default": "Trusted Manufacturer of Kiosks & Digital Signages"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub-headline",
      "default": "Custom-engineered interactive kiosks, digital signages, and electrical enclosures for hospitals, government, corporates, and smart city projects across India."
    },
    {
      "type": "header",
      "content": "CTA Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary button text",
      "default": "Explore Products"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary button text",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 40,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Overlay darkness",
      "default": 80
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 70,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum hero height",
      "default": 90
    },
    {
      "type": "header",
      "content": "Stats Card"
    },
    {
      "type": "text",
      "id": "stats_card_label",
      "label": "Card heading label",
      "default": "Our Achievements"
    },
    {
      "type": "text",
      "id": "stats_cta_text",
      "label": "Stats card CTA text",
      "default": "View all projects"
    },
    {
      "type": "url",
      "id": "stats_cta_url",
      "label": "Stats card CTA link"
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "500"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Projects Delivered"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "award", "label": "Award" },
            { "value": "factory", "label": "Factory" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "ISO Certified"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "eyebrow": "Premium Manufacturer · Ahmedabad, India",
        "heading": "Trusted Manufacturer of Kiosks & Digital Signages",
        "subheading": "Custom-engineered interactive kiosks, digital signages, and electrical enclosures for hospitals, government, corporates, and smart city projects across India.",
        "cta_primary_text": "Explore Products",
