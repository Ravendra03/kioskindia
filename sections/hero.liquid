{%- comment -%}
  MAXWELL HERO SECTION — ULTRA PREMIUM ENTERPRISE EDITION
{%- endcomment -%}

{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign trust_blocks = section.blocks | where: 'type', 'trust_badge'
-%}

<section
  class="hero-section"
  id="hero"
  aria-label="{{ section.settings.heading }}"
  style="--hero-min-height: {{ section.settings.min_height | default: 90 }}vh; --hero-overlay-opacity: {{ section.settings.overlay_opacity | default: 80 | divided_by: 100.0 }};"
>
  {%- comment -%} Background Image or Mesh Gradient {%- endcomment -%}
  <div class="hero__bg-wrap" aria-hidden="true">
    {%- if section.settings.bg_image != blank -%}
      {{
        section.settings.bg_image
        | image_url: width: 2560
        | image_tag:
          class: 'hero__bg-image',
          alt: section.settings.heading,
          loading: 'eager',
          fetchpriority: 'high',
          width: 2560
      }}
    {%- else -%}
      <div class="hero__bg-mesh"></div>
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__container">
    <div class="hero__grid">

      {%- comment -%} Left Column: Main Headline & CTAs {%- endcomment -%}
      <div class="hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow eyebrow--light" data-animate="fade-up">
            <span class="eyebrow__dot" aria-hidden="true"></span>
            {{ section.settings.eyebrow }}
          </div>
        {%- endif -%}

        <h1 class="hero__heading" data-animate="fade-up" data-delay="100" data-hero-headline>
          {{ section.settings.heading }}
        </h1>

        {%- if section.settings.subheading != blank -%}
          <p class="hero__subheading" data-animate="fade-up" data-delay="200">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}

        <div class="hero__ctas" data-animate="fade-up" data-delay="300">
          {%- if section.settings.cta_primary_text != blank -%}
            <a
              href="{{ section.settings.cta_primary_url | default: '/collections/all' }}"
              class="btn btn--accent btn--lg hero__btn-primary"
              id="hero-primary-cta"
            >
              {{ section.settings.cta_primary_text }}
              <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 20 %}</span>
            </a>
          {%- endif -%}

          {%- if section.settings.cta_secondary_text != blank -%}
            <a
              href="{{ section.settings.cta_secondary_url | default: '/pages/contact' }}"
              class="btn btn--secondary btn--lg hero__btn-secondary"
              id="hero-secondary-cta"
            >
              {{ section.settings.cta_secondary_text }}
            </a>
          {%- endif -%}

          {%- if settings.contact_phone != blank -%}
            <a
              href="tel:{{ settings.contact_phone_raw }}"
              class="btn btn--ghost hero__hotline"
              aria-label="Call B2B Sales Direct Hotline"
            >
              <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'phone', size: 18 %}</span>
              <span>Direct Sales: {{ settings.contact_phone }}</span>
            </a>
          {%- endif -%}
        </div>

        {%- comment -%} Trust Badges Strip {%- endcomment -%}
        {%- if section.settings.show_trust_badges and trust_blocks.size > 0 -%}
          <div class="hero__trust" data-animate="fade-up" data-delay="400">
            {%- for block in trust_blocks -%}
              <div class="hero__trust-item" {{ block.shopify_attributes }}>
                {% render 'icon', name: block.settings.icon, size: 16 %}
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right Column: Floating Stats Card {%- endcomment -%}
      {%- if stat_blocks.size > 0 -%}
        <div class="hero__stats-col" data-animate="fade-left" data-delay="300">
          <div class="hero__stats-card">

            <div class="hero__stats-card-header">
              <div class="hero__stats-card-icon" aria-hidden="true">
                {% render 'icon', name: 'award', size: 24 %}
              </div>
              <div class="hero__stats-card-meta">
                <span class="hero__stats-card-label">{{ section.settings.stats_card_label | default: 'Our Achievements' }}</span>
                <span class="hero__stats-card-sub">Industrial Hardware Manufacturing</span>
              </div>
            </div>

            <div class="hero__stats-grid">
              {%- for block in stat_blocks -%}
                <div class="hero__stat" {{ block.shopify_attributes }}>
                  <span
                    class="hero__stat-number"
                    data-counter="{{ block.settings.number }}"
                    data-suffix="{{ block.settings.suffix }}"
                  >
                    0
                  </span>
                  <span class="hero__stat-label">{{ block.settings.label }}</span>
                </div>
              {%- endfor -%}
            </div>

            {%- if section.settings.stats_cta_text != blank -%}
              <a
                href="{{ section.settings.stats_cta_url | default: '/pages/about' }}"
                class="hero__stats-cta"
              >
                <span>{{ section.settings.stats_cta_text }}</span>
                {% render 'icon', name: 'arrow-right', size: 16 %}
              </a>
            {%- endif -%}

          </div>
        </div>
      {%- endif -%}

    </div>
  </div>


</section>

<style>
  .hero-section {
    position: relative;
    min-height: auto;
    display: flex;
    align-items: center;
    color: var(--color-white);
    background-color: #171717;
    margin-top: 0;
    padding-top: 0;
    padding-bottom: var(--sp-10, 80px);
    overflow: hidden;
  }

  .hero__bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__bg-mesh {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 20% 20%, rgba(255, 107, 0, 0.25) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(23, 23, 23, 0.95) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, #171717 0%, #000000 100%);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.88) 0%, rgba(23, 23, 23, 0.82) 100%);
  }

  .hero__container {
    position: relative;
    z-index: 1;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-12);
    align-items: flex-start;
  }

  .eyebrow__dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-accent);
  }

  .hero__heading {
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .hero__subheading {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.85);
    line-height: var(--leading-relaxed);
    max-width: 620px;
    margin-bottom: var(--space-8);
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .hero__trust {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .hero__trust-item .icon {
    color: var(--color-accent);
  }

  /* Right Stats Card */
  .hero__stats-col {
    display: flex;
    justify-content: flex-end;
    align-self: flex-start;
  }

  .hero__stats-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-xl);
    padding: var(--space-4) var(--space-5);
    width: 100%;
    max-width: 350px;
    box-shadow: var(--shadow-xl);
  }

  .hero__stats-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero__stats-card-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-hover));
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-glow);
  }

  .hero__stats-card-meta {
    display: flex;
    flex-direction: column;
  }

  .hero__stats-card-label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
  }

  .hero__stats-card-sub {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero__stat-number {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1;
  }

  .hero__stat-label {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .hero__stats-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition);
  }

  .hero__stats-cta:hover {
    color: var(--color-white);
  }

  .hero__scroll {
    display: none;
  }

  @media (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .hero__stats-col {
      justify-content: start;
    }
    .hero__stats-card {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__btn-primary, .hero__btn-secondary {
      width: 100%;
    }
    .hero__stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Premium Manufacturer · Ahmedabad, India"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main headline",
      "default": "Trusted Manufacturer of Kiosks & Digital Signages"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub-headline",
      "default": "Custom-engineered interactive kiosks, digital signages, and electrical enclosures for hospitals, government, corporates, and smart city projects across India."
    },
    {
      "type": "header",
      "content": "CTA Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary button text",
      "default": "Explore Products"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary button text",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 40,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Overlay darkness",
      "default": 80
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 70,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Minimum hero height",
      "default": 90
    },
    {
      "type": "header",
      "content": "Stats Card"
    },
    {
      "type": "text",
      "id": "stats_card_label",
      "label": "Card heading label",
      "default": "Our Achievements"
    },
    {
      "type": "text",
      "id": "stats_cta_text",
      "label": "Stats card CTA text",
      "default": "View all projects"
    },
    {
      "type": "url",
      "id": "stats_cta_url",
      "label": "Stats card CTA link"
    },
    {
      "type": "header",
      "content": "Options"
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "500"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Projects Delivered"
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "award", "label": "Award" },
            { "value": "factory", "label": "Factory" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Badge text",
          "default": "ISO Certified"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "eyebrow": "Premium Manufacturer · Ahmedabad, India",
        "heading": "Trusted Manufacturer of Kiosks & Digital Signages",
        "subheading": "Custom-engineered interactive kiosks, digital signages, and electrical enclosures for hospitals, government, corporates, and smart city projects across India.",
        "cta_primary_text": "Explore Products",
        "cta_secondary_text": "Request a Quote",
        "overlay_opacity": 80,
        "min_height": 90,
        "stats_card_label": "Our Achievements",
        "stats_cta_text": "View all projects",
        "show_trust_badges": true,
        "show_scroll_indicator": true
      },
      "blocks": [
        { "type": "stat", "settings": { "number": "500", "suffix": "+", "label": "Projects Done" } },
        { "type": "stat", "settings": { "number": "200", "suffix": "+", "label": "Happy Clients" } },
        { "type": "stat", "settings": { "number": "8", "suffix": "+", "label": "Years Exp." } },
        { "type": "stat", "settings": { "number": "20", "suffix": "+", "label": "States Served" } },
        { "type": "trust_badge", "settings": { "icon": "shield", "text": "ISO Certified" } },
        { "type": "trust_badge", "settings": { "icon": "factory", "text": "In-House Manufacturing" } },
        { "type": "trust_badge", "settings": { "icon": "truck", "text": "Pan-India Delivery" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
