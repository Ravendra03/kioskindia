{%- comment -%}
  MAXWELL COLLECTION CATALOG SECTION — ENTERPRISE EDITION (ULTRA COMPACT LAYOUT)
{%- endcomment -%}

<section class="section collection-page">
  <div class="container">

    {%- comment -%} Compact Top Bar (Breadcrumbs + Title + Sort + Product Count) {%- endcomment -%}
    <div class="collection-page__top-bar" data-animate="fade-up">
      <div class="collection-page__heading-wrap">
        <div class="collection-page__breadcrumbs">
          <a href="{{ routes.root_url }}">Home</a>
          <span aria-hidden="true" class="sep">/</span>
          <span class="is-active">{{ collection.title | default: 'Products' }}</span>
        </div>
        <h1 class="collection-page__title">
          {{ collection.title | default: 'Product Catalog' }}
          <span class="collection-page__count-badge">{{ collection.products_count }} Products</span>
        </h1>
      </div>

      <div class="collection-page__sort-wrap">
        <label for="sort-by" class="collection-page__sort-label">Sort by:</label>
        <select id="sort-by" class="form-select collection-page__sort-select" onchange="location = this.value;">
          <option value="{{ collection.url }}?sort_by=manual">Featured</option>
          <option value="{{ collection.url }}?sort_by=title-ascending">Alphabetically, A-Z</option>
          <option value="{{ collection.url }}?sort_by=price-ascending">Price, low to high</option>
          <option value="{{ collection.url }}?sort_by=price-descending">Price, high to low</option>
          <option value="{{ collection.url }}?sort_by=created-descending">Date, new to old</option>
        </select>
      </div>
    </div>

    {%- comment -%} Quick Category Filter Pills {%- endcomment -%}
    <div class="collection-page__category-pills" data-animate="fade-up">
      <a href="/collections/all" class="category-pill is-active">
        All Products
      </a>
      {%- for cat in collections -%}
        {%- if cat.handle != 'all' and cat.products_count > 0 -%}
          <a href="{{ cat.url }}" class="category-pill{% if cat.handle == collection.handle %} is-active{% endif %}">
            {{ cat.title }} ({{ cat.products_count }})
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Product Grid {%- endcomment -%}
    {%- paginate collection.products by 12 -%}
      {%- if collection.products_count > 0 -%}
        <div class="collection-page__grid" data-animate="fade-up">
          {%- for product in collection.products -%}
            {%- liquid
              assign badge_text = ''
              assign badge_type = ''
              if product.tags contains 'new' or product.tags contains 'New'
                assign badge_text = 'New'
                assign badge_type = 'new'
              elsif product.compare_at_price > product.price
                assign badge_text = 'Sale'
                assign badge_type = 'sale'
              elsif product.tags contains 'featured' or product.tags contains 'Featured'
                assign badge_text = 'Featured'
                assign badge_type = 'featured'
              endif
            -%}

            <article class="product-card" aria-label="{{ product.title }}">

              <a href="{{ product.url }}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
                <div class="product-card__image-wrap">
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 600
                      | image_tag:
                        class: 'product-card__image product-card__image--primary',
                        alt: product.featured_image.alt | default: product.title,
                        loading: 'lazy',
                        width: 600
                    }}
                    {%- if product.images[1] != blank -%}
                      {{
                        product.images[1]
                        | image_url: width: 600
                        | image_tag:
                          class: 'product-card__image product-card__image--secondary',
                          alt: product.images[1].alt | default: product.title,
                          loading: 'lazy',
                          width: 600
                      }}
                    {%- endif -%}
                  {%- else -%}
                    <div class="product-card__image-placeholder" aria-hidden="true">
                      {% render 'icon', name: 'package', size: 48 %}
                    </div>
                  {%- endif -%}

                  {%- if badge_text != blank -%}
                    <span class="product-card__badge product-card__badge--{{ badge_type }}">
                      {{ badge_text }}
                    </span>
                  {%- endif -%}
                </div>
              </a>

              <div class="product-card__body">
                <span class="product-card__vendor">{{ product.vendor | default: 'Maxwell Automatic' }}</span>
                <h3 class="product-card__title">
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>

                <div class="product-card__tech-specs">
                  <span class="tech-spec-pill">ISO 9001:2015</span>
                  <span class="tech-spec-pill">In-House Mfg</span>
                </div>

                <div class="product-card__footer">
                  <div class="product-card__price">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="product-card__price-sale">{{ product.price | money }}</span>
                      <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
                    {%- elsif product.price == 0 -%}
                      <span class="product-card__price-label">Request Quote</span>
                    {%- else -%}
                      <span class="product-card__price-regular">{{ product.price | money }}</span>
                    {%- endif -%}
                  </div>

                  <a href="{{ product.url }}" class="btn btn--primary btn--sm product-card__cta">
                    View Details
                  </a>
                </div>
              </div>

            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="pagination">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}

      {%- else -%}
        <div class="collection-page__empty">
          <p>No products found in this category. Please check back soon or submit a custom RFP quote.</p>
          <a href="{{ routes.root_url }}" class="btn btn--secondary">Return to Homepage</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</section>

<style>
  .collection-page {
    background-color: var(--color-bg-page, #FFFFFF);
    padding-block: var(--space-4) var(--space-12);
  }

  .collection-page__top-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-4);
    gap: var(--space-4);
  }

  .collection-page__breadcrumbs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .collection-page__breadcrumbs a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .collection-page__breadcrumbs .sep {
    color: var(--color-text-light);
  }

  .collection-page__breadcrumbs .is-active {
    color: var(--color-text);
  }

  .collection-page__title {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 800;
    color: var(--color-text);
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .collection-page__count-badge {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    background-color: #FAFAFA;
    color: #171717;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-xl);
    border: 1px solid #E5E5E5;
  }

  .collection-page__sort-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .collection-page__sort-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: #171717;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .collection-page__sort-select {
    padding: 0.45rem 0.85rem;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    border: 1px solid #E5E5E5;
    border-radius: var(--radius-sm);
    background-color: #FAFAFA;
    color: #171717;
  }

  .collection-page__category-pills {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-6);
    scrollbar-width: thin;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.45rem 1rem;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: #171717;
    background-color: #FAFAFA;
    border: 1px solid #E5E5E5;
    border-radius: var(--radius-xl);
    text-decoration: none;
    white-space: nowrap;
    transition: all var(--transition);
  }

  .category-pill:hover {
    background-color: #171717;
    border-color: #171717;
    color: #E0A580;
  }

  .category-pill.is-active {
    background-color: #000000;
    color: #FFFFFF;
    border-color: #000000;
  }

  .collection-page__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  /* Product Card Image Sizing */
  .product-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-bounce), box-shadow var(--transition-bounce);
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-xl);
  }

  .product-card__image-link {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .product-card__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 280px;
    background-color: var(--color-bg-section);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s var(--ease-out);
  }

  .product-card:hover .product-card__image--primary {
    transform: scale(1.06);
  }

  .product-card__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.3;
  }

  .product-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .product-card__vendor {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .product-card__title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    margin: 0;
    line-height: 1.3;
  }

  .product-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .product-card__title a:hover {
    color: var(--color-primary);
  }

  .product-card__tech-specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-2);
  }

  .product-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .product-card__price-regular {
    font-size: var(--text-base);
    font-weight: 800;
    color: var(--color-primary);
  }

  .product-card__price-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .collection-page__empty {
    text-align: center;
    padding: var(--space-16);
    background-color: var(--color-bg-section);
    border-radius: var(--radius-2xl);
  }

  @media (max-width: 1024px) {
    .collection-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .collection-page__top-bar {
      flex-direction: column;
      align-items: flex-start;
    }
    .collection-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Collection Products",
  "class": "section-collection",
  "settings": []
}
{% endschema %}
