{%- comment -%}
  MAXWELL LATEST BLOG ARTICLES SECTION — ENTERPRISE EDITION
{%- endcomment -%}

{%- liquid
  assign blog = blogs[section.settings.blog]
  assign articles_to_show = section.settings.articles_to_show | default: 3
  assign has_blog = false
  if blog != blank and blog.articles_count > 0
    assign has_blog = true
  endif
  assign hide_mobile_class = ''
  if section.settings.hide_on_mobile
    assign hide_mobile_class = ' hide-mobile'
  endif
  assign hide_desktop_class = ''
  if section.settings.hide_on_desktop
    assign hide_desktop_class = ' hide-desktop'
  endif
-%}

<section
  class="section blog-section{{ hide_mobile_class }}{{ hide_desktop_class }}"
  id="latest-blogs"
  aria-labelledby="blogs-heading"
  style="
    --section-pt: {{ section.settings.padding_top | default: 80 }}px;
    --section-pb: {{ section.settings.padding_bottom | default: 80 }}px;
    --section-bg: {{ section.settings.bg_color | default: 'transparent' }};
  "
>
  {%- if section.settings.bg_image != blank -%}
    <div class="section__bg-wrap" aria-hidden="true">
      {{
        section.settings.bg_image
        | image_url: width: 2000
        | image_tag: class: 'section__bg-image', alt: '', loading: 'lazy'
      }}
      <div
        class="section__overlay"
        style="--section-overlay-opacity: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};"
      ></div>
    </div>
  {%- endif -%}

  <div class="container">

    <div class="blog-section__header">
      <div class="blog-section__header-text">
        {%- render 'section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subtitle: section.settings.subtitle,
          description: section.settings.description,
          heading_tag: 'h2',
          align: section.settings.alignment | default: 'left',
          animate: section.settings.enable_animation,
          section_id: 'blogs-heading'
        -%}
      </div>

      {%- if section.settings.cta_text != blank and has_blog -%}
        <a
          href="{{ blog.url }}"
          class="btn btn--secondary blog-section__header-cta"
        >
          {{ section.settings.cta_text }}
          <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
        </a>
      {%- endif -%}
    </div>

    <div
      class="blog-section__grid"
      {% if section.settings.enable_animation %}
        data-animate="{{ section.settings.animation_type | default: 'fade-up' }}"
      {% endif %}
    >
      {%- if has_blog -%}
        {%- for article in blog.articles limit: articles_to_show -%}
          <article class="article-card">
            <a href="{{ article.url }}" class="article-card__image-link" tabindex="-1" aria-hidden="true">
              <div class="article-card__image-wrap">
                {%- if article.image != blank -%}
                  {{
                    article.image
                    | image_url: width: 600
                    | image_tag: class: 'article-card__image', alt: article.title, loading: 'lazy'
                  }}
                {%- else -%}
                  <div class="article-card__placeholder" aria-hidden="true">
                    {% render 'icon', name: 'layers', size: 48 %}
                  </div>
                {%- endif -%}

                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}" class="article-card__date">
                  {{ article.published_at | date: '%b %d, %Y' }}
                </time>
              </div>
            </a>

            <div class="article-card__body">
              <span class="article-card__author">By {{ article.author | default: 'Maxwell Team' }}</span>
              <h3 class="article-card__title">
                <a href="{{ article.url }}" class="article-card__title-link">{{ article.title }}</a>
              </h3>
              <p class="article-card__excerpt">
                {{ article.excerpt_or_content | strip_html | truncate: 100 }}
              </p>
              <div class="article-card__footer">
                <a href="{{ article.url }}" class="article-card__read-more">
                  <span>Read Article</span>
                  {% render 'icon', name: 'arrow-right', size: 16 %}
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- elsif section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <article class="article-card" {{ block.shopify_attributes }}>
            <div class="article-card__image-wrap">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: class: 'article-card__image', alt: block.settings.title, loading: 'lazy'
                }}
              {%- else -%}
                <div class="article-card__placeholder" aria-hidden="true">
                  {% render 'icon', name: 'layers', size: 48 %}
                </div>
              {%- endif -%}

              <span class="article-card__date">{{ block.settings.date | default: 'Aug 2026' }}</span>
            </div>

            <div class="article-card__body">
              <span class="article-card__author">By {{ block.settings.author | default: 'Maxwell Engineering' }}</span>
              <h3 class="article-card__title">
                <a href="{{ block.settings.link | default: '#' }}" class="article-card__title-link">{{ block.settings.title }}</a>
              </h3>
              <p class="article-card__excerpt">{{ block.settings.excerpt }}</p>
              <div class="article-card__footer">
                <a href="{{ block.settings.link | default: '/pages/contact' }}" class="article-card__read-more">
                  <span>Read Article</span>
                  {% render 'icon', name: 'arrow-right', size: 16 %}
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

<style>
  .blog-section__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .blog-section__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .article-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .article-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-xl);
  }

  .article-card__image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    background-color: var(--color-bg-section);
    overflow: hidden;
  }

  .article-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .article-card:hover .article-card__image {
    transform: scale(1.06);
  }

  .article-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.25;
  }

  .article-card__date {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(8px);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-full);
  }

  .article-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .article-card__author {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .article-card__title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .article-card__title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition);
  }

  .article-card__title-link:hover {
    color: var(--color-primary);
  }

  .article-card__excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    flex: 1;
  }

  .article-card__footer {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .article-card__read-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    text-decoration: none;
    transition: color var(--transition);
  }

  .article-card__read-more:hover {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .blog-section__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .blog-section__grid {
      grid-template-columns: 1fr;
    }
    .blog-section__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Latest Articles",
  "class": "section-blog",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Insights & News"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading",
      "default": "Latest Technical Articles & Guides"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Read expert insights on kiosk manufacturing, digital signage trends, and electrical enclosure standards."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Detailed description"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Shopify Blog source"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Articles to show",
      "default": 3
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "View All Articles"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Background & Styling"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay darkness",
      "default": 0
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing & Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Visibility Controls"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile devices",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop devices",
      "default": false
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable scroll animations",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Animation type",
      "options": [
        { "value": "fade-up", "label": "Fade Up" },
        { "value": "fade-left", "label": "Fade Left" },
        { "value": "fade-right", "label": "Fade Right" },
        { "value": "zoom-in", "label": "Zoom In" }
      ],
      "default": "fade-up"
    }
  ],
  "blocks": [
    {
      "type": "article_card",
      "name": "Sample Article Card",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Article image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Choosing the Right Outdoor Digital Signage for Extreme Indian Weather" },
        { "type": "textarea", "id": "excerpt", "label": "Excerpt", "default": "A guide to thermal management, IP65 sealing, and high-nit displays for outdoor deployment." },
        { "type": "text", "id": "date", "label": "Date badge", "default": "Aug 2026" },
        { "type": "text", "id": "author", "label": "Author", "default": "Maxwell Engineering" },
        { "type": "url", "id": "link", "label": "Article link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Latest Articles",
      "settings": {
        "eyebrow": "Insights & News",
        "heading": "Latest Technical Articles & Guides",
        "subtitle": "Read expert insights on kiosk manufacturing, digital signage trends, and electrical enclosure standards.",
        "articles_to_show": 3,
        "cta_text": "View All Articles",
        "padding_top": 80,
        "padding_bottom": 80,
        "enable_animation": true,
        "animation_type": "fade-up"
      },
      "blocks": [
        { "type": "article_card", "settings": { "title": "Choosing the Right Outdoor Digital Signage for Extreme Indian Weather", "excerpt": "A guide to thermal management, IP65 sealing, and high-nit displays for outdoor deployment.", "date": "Aug 2026" } },
        { "type": "article_card", "settings": { "title": "How Interactive Kiosks Streamline OPD Queues in Government Hospitals", "excerpt": "Case study analysis of patient self-check-in terminals across Indian hospital networks.", "date": "Jul 2026" } },
        { "type": "article_card", "settings": { "title": "MS vs Stainless Steel Enclosures: Selecting the Best Material for Industrial Panels", "excerpt": "Understanding corrosion resistance, powder coating specs, and NEMA ratings.", "date": "Jun 2026" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
