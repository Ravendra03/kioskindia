{%- comment -%}
  MAXWELL GOOGLE MAP & FACTORY LOCATION SECTION — ENTERPRISE EDITION
{%- endcomment -%}

{%- liquid
  assign hide_mobile_class = ''
  if section.settings.hide_on_mobile
    assign hide_mobile_class = ' hide-mobile'
  endif
  assign hide_desktop_class = ''
  if section.settings.hide_on_desktop
    assign hide_desktop_class = ' hide-desktop'
  endif
-%}

<section
  class="section google-map-section{{ hide_mobile_class }}{{ hide_desktop_class }}"
  id="google-map"
  aria-labelledby="map-heading"
  style="
    --section-pt: {{ section.settings.padding_top | default: 80 }}px;
    --section-pb: {{ section.settings.padding_bottom | default: 80 }}px;
    --section-bg: {{ section.settings.bg_color | default: 'transparent' }};
  "
>
  {%- if section.settings.bg_image != blank -%}
    <div class="section__bg-wrap" aria-hidden="true">
      {{
        section.settings.bg_image
        | image_url: width: 2000
        | image_tag: class: 'section__bg-image', alt: '', loading: 'lazy'
      }}
      <div
        class="section__overlay"
        style="--section-overlay-opacity: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};"
      ></div>
    </div>
  {%- endif -%}

  <div class="container">

    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtitle: section.settings.subtitle,
      description: section.settings.description,
      heading_tag: 'h2',
      align: section.settings.alignment | default: 'center',
      animate: section.settings.enable_animation,
      section_id: 'map-heading'
    -%}

    <div
      class="map__card"
      {% if section.settings.enable_animation %}
        data-animate="{{ section.settings.animation_type | default: 'fade-up' }}"
      {% endif %}
    >
      {%- comment -%} Map Iframe Wrap {%- endcomment -%}
      <div class="map__iframe-wrap">
        {%- if section.settings.map_embed_url != blank -%}
          <iframe
            src="{{ section.settings.map_embed_url }}"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Maxwell Automatic Factory Location Map"
          ></iframe>
        {%- else -%}
          <iframe
            src="https://maps.google.com/maps?q=Vatwa+GIDC+Phase+1+Ahmedabad+Gujarat+India&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Maxwell Automatic Factory Location Map"
          ></iframe>
        {%- endif -%}
      </div>

      {%- comment -%} Floating Location Info Card {%- endcomment -%}
      <div class="map__info-box">
        <div class="map__info-header">
          <span class="map__info-badge">Manufacturing Unit</span>
          <h3 class="map__info-title">{{ section.settings.factory_name | default: 'Maxwell Automatic Factory' }}</h3>
        </div>

        <div class="map__info-details">
          <div class="map__info-row">
            {% render 'icon', name: 'map-pin', size: 18 %}
            <span>{{ section.settings.factory_address | default: 'Phase 1, Vatwa GIDC, Ahmedabad, Gujarat 382445, India' }}</span>
          </div>
          <div class="map__info-row">
            {% render 'icon', name: 'clock', size: 18 %}
            <span>{{ section.settings.factory_hours | default: 'Mon – Sat: 9:00 AM – 7:00 PM' }}</span>
          </div>
        </div>

        {%- if section.settings.cta_text != blank -%}
          <a
            href="{{ section.settings.cta_url | default: 'https://maps.google.com' }}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--accent btn--sm map__info-btn"
          >
            {{ section.settings.cta_text }}
            <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 16 %}</span>
          </a>
        {%- endif -%}
      </div>

    </div>

  </div>
</section>

<style>
  .map__card {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--color-border);
    height: 480px;
    background-color: var(--color-bg-section);
  }

  .map__iframe-wrap {
    width: 100%;
    height: 100%;
  }

  .map__info-box {
    position: absolute;
    bottom: var(--space-6);
    left: var(--space-6);
    background: rgba(0, 26, 51, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    max-width: 380px;
    box-shadow: var(--shadow-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .map__info-badge {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .map__info-title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
    margin: 0;
  }

  .map__info-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .map__info-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.8);
    line-height: var(--leading-relaxed);
  }

  .map__info-row .icon {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .map__info-btn {
    width: 100%;
  }

  @media (max-width: 767px) {
    .map__card {
      height: 560px;
    }
    .map__info-box {
      position: relative;
      bottom: auto;
      left: auto;
      max-width: 100%;
      border-radius: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Google Map & Factory",
  "class": "section-google-map",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Factory Location"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading",
      "default": "Visit Our Manufacturing Unit in Ahmedabad"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Schedule a factory tour to inspect our fabrication setup, powder coating line, and live product demos."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Detailed description"
    },
    {
      "type": "text",
      "id": "map_embed_url",
      "label": "Google Maps Embed iFrame src URL"
    },
    {
      "type": "text",
      "id": "factory_name",
      "label": "Factory name label",
      "default": "Maxwell Automatic Factory"
    },
    {
      "type": "textarea",
      "id": "factory_address",
      "label": "Factory address text",
      "default": "Phase 1, Vatwa GIDC, Ahmedabad, Gujarat 382445, India"
    },
    {
      "type": "text",
      "id": "factory_hours",
      "label": "Operating hours text",
      "default": "Mon – Sat: 9:00 AM – 7:00 PM"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Get Directions on Google Maps"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Background & Styling"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay darkness",
      "default": 0
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing & Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Visibility Controls"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile devices",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop devices",
      "default": false
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable scroll animations",
      "default": true
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Animation type",
      "options": [
        { "value": "fade-up", "label": "Fade Up" },
        { "value": "fade-left", "label": "Fade Left" },
        { "value": "fade-right", "label": "Fade Right" },
        { "value": "zoom-in", "label": "Zoom In" }
      ],
      "default": "fade-up"
    }
  ],
  "presets": [
    {
      "name": "Google Map & Factory",
      "settings": {
        "eyebrow": "Factory Location",
        "heading": "Visit Our Manufacturing Unit in Ahmedabad",
        "subtitle": "Schedule a factory tour to inspect our fabrication setup, powder coating line, and live product demos.",
        "factory_name": "Maxwell Automatic Factory",
        "factory_address": "Phase 1, Vatwa GIDC, Ahmedabad, Gujarat 382445, India",
        "factory_hours": "Mon – Sat: 9:00 AM – 7:00 PM",
        "cta_text": "Get Directions on Google Maps",
        "padding_top": 80,
        "padding_bottom": 80,
        "enable_animation": true,
        "animation_type": "fade-up"
      }
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
