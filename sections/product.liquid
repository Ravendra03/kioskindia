{%- comment -%}
  MAXWELL PRODUCT DETAIL PAGE SECTION — ENTERPRISE EDITION
{%- endcomment -%}

<section class="section product-page">
  <div class="container">

    {%- comment -%} Breadcrumb Navigation {%- endcomment -%}
    <div class="product-page__breadcrumbs" data-animate="fade-up">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/collections/all">Products</a>
      <span aria-hidden="true">/</span>
      <span class="is-active">{{ product.title }}</span>
    </div>

    <div class="product-page__layout" data-animate="fade-up">

      {%- comment -%} Left Column: Product Image Gallery {%- endcomment -%}
      <div class="product-page__media">
        <div class="product-page__image-stage">
          {%- if product.featured_image != blank -%}
            {{
              product.featured_image
              | image_url: width: 800
              | image_tag:
                class: 'product-page__main-image',
                alt: product.featured_image.alt | default: product.title,
                loading: 'eager',
                fetchpriority: 'high',
                id: 'main-product-image'
            }}
          {%- else -%}
            <div class="product-page__image-placeholder">
              {% render 'icon', name: 'package', size: 80 %}
            </div>
          {%- endif -%}

          {%- if product.compare_at_price > product.price -%}
            <span class="badge badge--accent product-page__sale-badge">Sale</span>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-page__thumbnails">
            {%- for image in product.images -%}
              <button
                type="button"
                class="product-page__thumb-btn{% if forloop.first %} is-active{% endif %}"
                onclick="document.getElementById('main-product-image').src='{{ image | image_url: width: 800 }}';"
              >
                {{ image | image_url: width: 150 | image_tag: alt: product.title, loading: 'lazy' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Right Column: Product Specs & Ordering {%- endcomment -%}
      <div class="product-page__info">
        <div class="product-page__vendor">{{ product.vendor | default: 'Maxwell Automatic' }}</div>
        <h1 class="product-page__title">{{ product.title }}</h1>

        <div class="product-page__tech-specs">
          <span class="tech-spec-pill">ISO 9001:2015</span>
          <span class="tech-spec-pill">In-House Manufacturing</span>
          <span class="tech-spec-pill">IP65 Weatherproof</span>
          <span class="tech-spec-pill">1 Year Warranty</span>
        </div>

        <div class="product-page__price-row">
          {%- if product.compare_at_price > product.price -%}
            <span class="product-page__price product-page__price--sale">{{ product.price | money }}</span>
            <span class="product-page__price-compare">{{ product.compare_at_price | money }}</span>
          {%- elsif product.price == 0 -%}
            <span class="product-page__price-quote">Contact Sales for OEM Bulk Quote</span>
          {%- else -%}
            <span class="product-page__price">{{ product.price | money }}</span>
          {%- endif -%}
        </div>

        <div class="product-page__desc">
          {{ product.description }}
        </div>

        {%- comment -%} Add to Cart / RFP Form {%- endcomment -%}
        {% form 'product', product, class: 'product-page__form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- if product.variants.size > 1 -%}
            <div class="form-group">
              <label for="variant-select" class="form-label">Select Model / Variant:</label>
              <select id="variant-select" name="id" class="form-select">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                    {{ variant.title }} - {{ variant.price | money }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          <div class="product-page__actions">
            <button type="submit" class="btn btn--accent btn--lg product-page__btn-submit">
              Submit RFP Inquiry
              <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
            </button>

            <a
              href="https://wa.me/{{ settings.contact_whatsapp | default: '919825000000' }}?text=Hello%2C%20I%20want%20more%20details%20about%20{{ product.title | url_encode }}"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--secondary btn--lg"
            >
              WhatsApp Inquiry
            </a>
          </div>
        {% endform %}

        <div class="product-page__trust-strip">
          <div class="product-page__trust-item">
            {% render 'icon', name: 'factory', size: 20 %}
            <span>100% In-House Mfg</span>
          </div>
          <div class="product-page__trust-item">
            {% render 'icon', name: 'truck', size: 20 %}
            <span>Pan-India Delivery</span>
          </div>
          <div class="product-page__trust-item">
            {% render 'icon', name: 'shield', size: 20 %}
            <span>ISO Certified QA</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .product-page {
    padding-block: var(--space-12) var(--space-20);
  }

  .product-page__breadcrumbs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .product-page__breadcrumbs a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .product-page__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .product-page__image-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 480px;
    background-color: var(--color-bg-section);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-page__main-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-4);
  }

  .product-page__image-placeholder {
    color: var(--color-primary);
    opacity: 0.3;
  }

  .product-page__thumbnails {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    overflow-x: auto;
  }

  .product-page__thumb-btn {
    width: 72px;
    height: 72px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-section);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .product-page__thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-page__vendor {
    font-size: var(--text-xs);
    font-weight: 800;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--space-2);
  }

  .product-page__title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .product-page__tech-specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .product-page__price-row {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .product-page__price {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-primary);
  }

  .product-page__price-quote {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
  }

  .product-page__desc {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  .product-page__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .product-page__trust-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-bg-section);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .product-page__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .product-page__layout {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Product Detail",
  "class": "section-product",
  "settings": []
}
{% endschema %}
