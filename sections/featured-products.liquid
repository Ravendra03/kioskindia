{%- comment -%}
  MAXWELL FEATURED PRODUCTS SECTION — PREMIUM EDITION
{%- endcomment -%}

{%- liquid
  assign products_to_show = section.settings.products_to_show | default: 4
  assign collection = collections[section.settings.collection]
  assign has_collection = false
  if collection != blank and collection.products_count > 0
    assign has_collection = true
  elsif collections.all != blank and collections.all.products_count > 0
    assign collection = collections.all
    assign has_collection = true
  endif
-%}

<section
  class="section featured-products"
  id="featured-products"
  aria-labelledby="featured-products-heading"
>
  <div class="container">

    <div class="featured-products__header">
      <div class="featured-products__header-text">
        {%- render 'section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subtitle: section.settings.subtitle,
          heading_tag: 'h2',
          align: 'left',
          theme: 'light',
          section_id: 'featured-products-heading'
        -%}
      </div>
      {%- if section.settings.cta_text != blank and has_collection -%}
        <a
          href="{{ collection.url }}"
          class="btn btn--secondary featured-products__header-cta"
          data-animate="fade-left"
          id="featured-products-cta"
        >
          {{ section.settings.cta_text }}
          <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
        </a>
      {%- endif -%}
    </div>

    <div
      class="featured-products__grid"
      data-animate="fade-up"
      data-delay="100"
    >

      {%- if has_collection -%}

        {%- for product in collection.products limit: products_to_show -%}
          {%- liquid
            assign badge_text = ''
            assign badge_type = ''
            if product.tags contains 'new' or product.tags contains 'New'
              assign badge_text = 'New'
              assign badge_type = 'new'
            elsif product.compare_at_price > product.price
              assign badge_text = 'Sale'
              assign badge_type = 'sale'
            elsif product.tags contains 'featured' or product.tags contains 'Featured'
              assign badge_text = 'Featured'
              assign badge_type = 'featured'
            endif
          -%}
          <article class="product-card" aria-label="{{ product.title }}">

            <a href="{{ product.url }}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
              <div class="product-card__image-wrap">
                {%- if product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 600
                    | image_tag:
                      class: 'product-card__image product-card__image--primary',
                      alt: product.featured_image.alt | default: product.title,
                      loading: 'lazy',
                      width: 600
                  }}
                  {%- if product.images[1] != blank -%}
                    {{
                      product.images[1]
                      | image_url: width: 600
                      | image_tag:
                        class: 'product-card__image product-card__image--secondary',
                        alt: product.images[1].alt | default: product.title,
                        loading: 'lazy',
                        width: 600
                    }}
                  {%- endif -%}
                {%- else -%}
                  <div class="product-card__image-placeholder" aria-hidden="true">
                    {% render 'icon', name: 'package', size: 48 %}
                  </div>
                {%- endif -%}

                {%- if badge_text != blank -%}
                  <span class="product-card__badge product-card__badge--{{ badge_type }}">
                    {{ badge_text }}
                  </span>
                {%- else -%}
                  <span class="badge badge--sale">Save 20%</span>
                {%- endif -%}
                <span class="rating-pill"><span class="star-icon">★</span> 4.8</span>
              </div>
            </a>

            <div class="product-card__body">
              {%- if product.vendor != blank -%}
                <span class="product-card__vendor">{{ product.vendor }}</span>
              {%- endif -%}
              <h3 class="product-card__title">
                <a href="{{ product.url }}" class="product-card__title-link">{{ product.title }}</a>
              </h3>
              {%- if product.description != blank -%}
                <p class="product-card__desc">{{ product.description | strip_html | truncate: 80 }}</p>
              {%- endif -%}

              <div class="product-card__specs">
                <span class="tech-spec-pill">{% render 'icon', name: 'check-circle', size: 12 %} ISO 9001</span>
                <span class="tech-spec-pill">{% render 'icon', name: 'factory', size: 12 %} In-House Mfg</span>
              </div>
              <div class="product-card__footer">
                <div class="product-card__price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="product-card__price-sale">{{ product.price | money }}</span>
                    <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
                  {%- elsif product.price == 0 -%}
                    <span class="product-card__price-label">Get Quote</span>
                  {%- else -%}
                    <span class="product-card__price-regular">{{ product.price | money }}</span>
                  {%- endif -%}
                </div>
                <a
                  href="{{ product.url }}"
                  class="product-card__cta btn btn--primary btn--sm"
                >
                  {{ section.settings.card_cta_text | default: 'View Details' }}
                </a>
              </div>
            </div>

          </article>
        {%- endfor -%}

      {%- elsif section.blocks.size > 0 -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'product_card' -%}
            <article class="product-card" aria-label="{{ block.settings.title }}" {{ block.shopify_attributes }}>

              <div class="product-card__image-wrap">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      class: 'product-card__image product-card__image--primary',
                      alt: block.settings.title,
                      loading: 'lazy',
                      width: 600
                  }}
                {%- else -%}
                  <div class="product-card__image-placeholder" aria-hidden="true">
                    {% render 'icon', name: 'package', size: 48 %}
                  </div>
                {%- endif -%}
                {%- if block.settings.badge != blank -%}
                  <span class="product-card__badge product-card__badge--featured">{{ block.settings.badge }}</span>
                {%- endif -%}
              </div>

              <div class="product-card__body">
                <h3 class="product-card__title">
                  <a href="{{ block.settings.link | default: '#' }}" class="product-card__title-link">{{ block.settings.title }}</a>
                </h3>
                {%- if block.settings.description != blank -%}
                  <p class="product-card__desc">{{ block.settings.description | truncate: 80 }}</p>
                {%- endif -%}

                <div class="product-card__specs">
                  <span class="tech-spec-pill">{% render 'icon', name: 'check-circle', size: 12 %} ISO 9001</span>
                  <span class="tech-spec-pill">{% render 'icon', name: 'factory', size: 12 %} Factory Direct</span>
                </div>
                <div class="product-card__footer">
                  <div class="product-card__price">
                    {%- if block.settings.price != blank -%}
                      <span class="product-card__price-regular">{{ block.settings.price }}</span>
                    {%- else -%}
                      <span class="product-card__price-label">Get Quote</span>
                    {%- endif -%}
                  </div>
                  <a
                    href="{{ block.settings.link | default: '/pages/contact' }}"
                    class="product-card__cta btn btn--primary btn--sm"
                  >
                    {{ section.settings.card_cta_text | default: 'View Details' }}
                  </a>
                </div>
              </div>

            </article>
          {%- endif -%}
        {%- endfor -%}

      {%- endif -%}

    </div>

  </div>
</section>

<style>
  .featured-products {
    background-color: var(--color-bg-section, #F7F9FB) !important;
    position: relative;
    z-index: 1;
  }

  .featured-products .section-header {
    margin-bottom: 0;
  }

  .featured-products__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .featured-products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .product-card {
    background-color: #FFFFFF;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border, #DDE4EA);
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .product-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-blue-primary, #0866D6);
    transform: translateY(-4px);
  }

  .product-card__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    max-height: 200px;
    background-color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-slow) var(--ease-out);
  }

  .product-card__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .product-card:hover .product-card__image--primary {
    opacity: 0;
  }

  .product-card:hover .product-card__image--secondary {
    opacity: 1;
    transform: scale(1.05);
  }

  .product-card:hover .product-card__image--primary:only-child {
    opacity: 1;
    transform: scale(1.05);
  }

  .product-card__image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.25;
    padding: var(--space-4);
  }

  .product-card__badge,
  .badge--sale {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 0.72rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full, 50px);
    line-height: 1;
    background-color: var(--color-sale-red, #E51D48);
    color: #FFFFFF !important;
    z-index: 2;
  }

  .rating-pill {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    color: #171717;
    background-color: #FFFFFF;
    border-radius: var(--radius-full, 50px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    z-index: 2;
  }

  .rating-pill .star-icon {
    color: var(--color-star-gold, #F59E0B);
  }

  .product-card__body {
    padding: 0.9rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .product-card__vendor {
    font-size: 0.65rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-blue-primary, #0866D6);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
  }

  .product-card__title {
    font-size: 0.92rem;
    font-weight: var(--font-weight-bold);
    line-height: 1.25;
    margin: 0;
  }

  .product-card__title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition);
  }

  .product-card__title-link:hover {
    color: var(--color-primary);
  }

  .product-card__desc {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--color-border);
  }

  .product-card__price-regular,
  .product-card__price-label {
    font-size: 0.85rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  @media (max-width: 1200px) {
    .featured-products__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 767px) {
    .featured-products__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }

  @media (max-width: 480px) {
    .featured-products__grid {
      grid-template-columns: 1fr;
    }
    .featured-products__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "class": "section-featured-products",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Top Products"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading",
      "default": "Our Flagship Products"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Precision-built products trusted by 200+ clients across India."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Number of products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "card_cta_text",
      "label": "Card button text",
      "default": "View Details"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "View all button text",
      "default": "View All Products"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Manual product card",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product image" },
        { "type": "text", "id": "title", "label": "Product name", "default": "Interactive Kiosk" },
        { "type": "textarea", "id": "description", "label": "Short description", "default": "Custom-built touch-screen kiosk for self-service applications." },
        { "type": "text", "id": "price", "label": "Price or quote label", "placeholder": "Get Quote" },
        { "type": "text", "id": "badge", "label": "Badge text", "placeholder": "New Launch" },
        { "type": "url", "id": "link", "label": "Product link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "settings": {
        "eyebrow": "Top Products",
        "heading": "Our Flagship Products",
        "subtitle": "Precision-built products trusted by 200+ clients across India.",
        "products_to_show": 4,
        "card_cta_text": "View Details",
        "cta_text": "View All Products"
      },
      "blocks": [
        { "type": "product_card", "settings": { "title": "Floor-Standing Interactive Kiosk", "description": "21.5\" touch display, i5 processor, thermal printer, card reader.", "badge": "Best Seller" } },
        { "type": "product_card", "settings": { "title": "Outdoor Digital Signage Totem", "description": "IP65 weatherproof, 2500-nit brightness, 65\" 4K display.", "badge": "Popular" } },
        { "type": "product_card", "settings": { "title": "Smart Locker System", "description": "Modular intelligent locker with cloud-based access control.", "badge": "New" } },
        { "type": "product_card", "settings": { "title": "Queue Management Kiosk", "description": "Token-dispensing kiosk with SMS alert integration.", "badge": "Featured" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
