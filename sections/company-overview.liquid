{%- comment -%}
  MAXWELL COMPANY OVERVIEW SECTION — PREMIUM EDITION
{%- endcomment -%}

{%- liquid
  assign capability_blocks = section.blocks | where: 'type', 'capability'
  assign milestone_blocks = section.blocks | where: 'type', 'milestone'
-%}

<section
  class="section company-overview"
  id="company-overview"
  style="background-color: #FFFFFF;"
  aria-labelledby="company-overview-heading"
>
  <div class="container">

    <div class="company-overview__grid">

      {%- comment -%} Left Column: Image with Experience Badge {%- endcomment -%}
      <div class="company-overview__media" data-animate="fade-right">
        <div class="company-overview__image-wrap">
          {%- if section.settings.factory_image != blank -%}
            {{
              section.settings.factory_image
              | image_url: width: 900
              | image_tag:
                class: 'company-overview__image',
                alt: 'Maxwell Automatic Factory',
                loading: 'lazy',
                width: 900
            }}
          {%- else -%}
            <img
              src="{{ 'maxwell-factory.jpg' | asset_url }}"
              alt="Maxwell Automatic Manufacturing Plant - Vatwa GIDC"
              class="company-overview__image"
              loading="lazy"
              width="900"
              height="675"
            >
          {%- endif -%}

          {%- comment -%} Floating Experience Badge {%- endcomment -%}
          {%- if section.settings.experience_number != blank -%}
            <div class="company-overview__exp-badge" data-animate="zoom-in" data-delay="300">
              <span class="company-overview__exp-num">{{ section.settings.experience_number }}</span>
              <span class="company-overview__exp-label">{{ section.settings.experience_label | default: 'Years of Excellence' }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Right Column: Text & Capabilities {%- endcomment -%}
      <div class="company-overview__content" data-animate="fade-left">
        {%- render 'section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subtitle: section.settings.subtitle,
          heading_tag: 'h2',
          align: 'left',
          theme: 'light',
          section_id: 'company-overview-heading'
        -%}

        {%- if capability_blocks.size > 0 -%}
          <div class="company-overview__capabilities">
            {%- for block in capability_blocks -%}
              <div class="company-overview__cap-card" {{ block.shopify_attributes }}>
                <div class="company-overview__cap-icon" aria-hidden="true">
                  {% render 'icon', name: block.settings.icon, size: 24 %}
                </div>
                <div class="company-overview__cap-text">
                  <h3 class="company-overview__cap-title">{{ block.settings.title }}</h3>
                  <p class="company-overview__cap-desc">{{ block.settings.description }}</p>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="company-overview__ctas" data-animate="fade-up" data-delay="300">
          {%- if section.settings.cta_primary_text != blank -%}
            <a
              href="{{ section.settings.cta_primary_url | default: '/pages/about' }}"
              class="btn btn--secondary"
              id="about-primary-cta"
            >
              {{ section.settings.cta_primary_text }}
              <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
            </a>
          {%- endif -%}

          {%- if section.settings.video_url != blank -%}
            <button
              class="btn btn--ghost company-overview__video-btn"
              data-video-url="{{ section.settings.video_url }}"
              data-video-modal
              type="button"
              aria-label="Watch our manufacturing video"
              id="about-video-btn"
            >
              <span class="company-overview__play-icon" aria-hidden="true">
                {% render 'icon', name: 'play', size: 18 %}
              </span>
              {{ section.settings.video_cta_text | default: 'Watch our process' }}
            </button>
          {%- endif -%}
        </div>
      </div>

    </div>

    {%- comment -%} Milestones Timeline — Innovative Industrial Roadmap {%- endcomment -%}
    {%- if section.settings.show_timeline and milestone_blocks.size > 0 -%}
      <div class="company-overview__timeline-wrap" data-animate="fade-up">
        <div class="company-overview__timeline-header">
          <span class="eyebrow eyebrow--light" style="margin-inline: auto;">Milestones & Growth</span>
          <h3 class="company-overview__timeline-title">{{ section.settings.timeline_heading | default: 'Our Journey' }}</h3>
        </div>
        <div class="company-overview__timeline">
          {%- for block in milestone_blocks -%}
            <div class="company-overview__milestone" {{ block.shopify_attributes }}>
              <div class="company-overview__milestone-badge">
                <span class="company-overview__milestone-node" aria-hidden="true"></span>
                <span class="company-overview__milestone-year">{{ block.settings.year }}</span>
              </div>
              <div class="company-overview__milestone-card">
                <p class="company-overview__milestone-event">{{ block.settings.event }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} Video Lightbox Modal {%- endcomment -%}
{%- if section.settings.video_url != blank -%}
  <div
    class="video-modal"
    id="video-modal-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-label="Manufacturing process video"
    data-video-modal-container
  >
    <div class="video-modal__box">
      <button
        class="video-modal__close"
        data-video-modal-close
        aria-label="Close video"
        type="button"
      >
        {% render 'icon', name: 'close', size: 24 %}
      </button>
      <div class="video-modal__embed" id="video-embed-{{ section.id }}"></div>
    </div>
  </div>
{%- endif -%}

<style>
  .company-overview__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: flex-start;
  }

  .company-overview__image-wrap {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--color-border);
    aspect-ratio: 4 / 3;
    background-color: var(--color-bg-section);
  }

  .company-overview__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .company-overview__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    color: var(--color-primary);
    background: linear-gradient(135deg, var(--color-primary-light), rgba(0, 102, 204, 0.05));
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }

  .company-overview__exp-badge {
    position: absolute;
    bottom: var(--space-6);
    right: var(--space-6);
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: var(--color-white);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: var(--shadow-2xl);
    border: 2px solid rgba(255, 255, 255, 0.2);
  }

  .company-overview__exp-num {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1;
  }

  .company-overview__exp-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .company-overview {
    background-color: #FFFFFF !important;
    position: relative;
    z-index: 1;
  }

  .company-overview .section-header {
    margin-bottom: var(--space-4);
  }

  /* Capabilities Grid */
  .company-overview__capabilities {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: 0;
    margin-bottom: var(--space-6);
  }

  .company-overview__cap-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: #FFFFFF;
    border-radius: var(--radius-xl);
    border: 1px solid #E2E8F0;
    box-shadow: 0 4px 14px rgba(0, 31, 63, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .company-overview__cap-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 31, 63, 0.12);
    border-color: #0088FF;
  }

  .company-overview__cap-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #0F4C81 0%, #001A33 100%);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: inset 0 2px 5px rgba(255, 255, 255, 0.45), inset 0 -3px 6px rgba(0, 0, 0, 0.6), 0 8px 18px -2px rgba(0, 51, 102, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease, background 0.3s ease;
  }

  .company-overview__cap-card:hover .company-overview__cap-icon {
    transform: translateY(-3px) scale(1.05);
    background: linear-gradient(135deg, #0055A5 0%, #001A33 100%);
    box-shadow: inset 0 2px 5px rgba(255, 255, 255, 0.6), inset 0 -3px 6px rgba(0, 0, 0, 0.4), 0 10px 22px -3px rgba(0, 85, 165, 0.4);
  }

  .company-overview__cap-title {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0;
  }

  .company-overview__cap-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .company-overview__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .company-overview__video-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Innovative High-Tech Timeline */
  .company-overview__timeline-wrap {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid #E2E8F0;
    position: relative;
  }

  .company-overview__timeline-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .company-overview__timeline-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    margin-top: var(--space-2);
    letter-spacing: var(--tracking-tight);
  }

  .company-overview__timeline {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
    position: relative;
    z-index: 1;
  }

  .company-overview__milestone {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: transform 0.3s var(--ease-out);
  }

  .company-overview__milestone:hover {
    transform: translateY(-6px);
  }

  .company-overview__milestone-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.35rem 0.85rem;
    background: linear-gradient(135deg, #001F3F 0%, #004C99 100%);
    border-radius: var(--radius-full);
    color: #FFFFFF;
    box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.4), 0 4px 14px rgba(0, 31, 63, 0.25);
    margin-bottom: var(--space-3);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .company-overview__milestone-node {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #00A3FF;
    box-shadow: 0 0 10px #00A3FF;
  }

  .company-overview__milestone-year {
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: var(--tracking-wider);
  }

  .company-overview__milestone-card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: var(--radius-xl);
    padding: var(--space-4);
    box-shadow: 0 4px 14px rgba(0, 31, 63, 0.05);
    width: 100%;
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .company-overview__milestone:hover .company-overview__milestone-card {
    border-color: #0088FF;
    box-shadow: 0 12px 30px rgba(0, 136, 255, 0.18);
  }

  .company-overview__milestone-event {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* Modal */
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background-color: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition);
  }

  .video-modal.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .video-modal__box {
    position: relative;
    width: 100%;
    max-width: 900px;
    background-color: #000;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .video-modal__close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 2;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: var(--color-white);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  @media (max-width: 1024px) {
    .company-overview__grid {
      grid-template-columns: 1fr;
    }
    .company-overview__timeline {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .company-overview__capabilities {
      grid-template-columns: 1fr;
    }
    .company-overview__timeline {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
