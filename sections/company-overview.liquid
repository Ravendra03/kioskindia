{%- comment -%}
  MAXWELL COMPANY OVERVIEW SECTION
  ─────────────────────────────────────────────────────────────────────────────
  Features:
  - Split layout: media left, content right
  - Eyebrow + Heading + Description
  - 4 icon-based capability highlights (blocks)
  - Editable milestones / timeline (blocks)
  - Company Profile PDF download CTA
  - "Watch video" button with lightbox modal
  - Fully responsive: stacks on mobile
  - All content from Theme Editor — zero hardcoded text
  ─────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

<section
  class="section{% if section.settings.bg_style == 'alt' %} section--alt{% endif %} company-overview"
  id="company-overview"
  aria-labelledby="company-overview-heading"
>
  <div class="container">

    <div class="company-overview__grid">

      {%- comment -%} ── Left: Media Column ──────────────────────────────── {%- endcomment -%}
      <div class="company-overview__media" data-animate="fade-right">

        {%- comment -%} Main Image {%- endcomment -%}
        <div class="company-overview__image-wrap">
          {%- if section.settings.main_image != blank -%}
            {{
              section.settings.main_image
              | image_url: width: 800
              | image_tag:
                class: 'company-overview__image',
                alt: section.settings.main_image.alt | default: section.settings.heading,
                loading: 'lazy',
                width: 800
            }}
          {%- else -%}
            <div class="company-overview__image-placeholder" aria-hidden="true">
              <div class="company-overview__placeholder-icon">
                {% render 'icon', name: 'factory', size: 64 %}
              </div>
              <p>Upload a factory / team image</p>
            </div>
          {%- endif -%}

          {%- comment -%} Floating accent card: years of experience ─────── {%- endcomment -%}
          {%- if section.settings.experience_number != blank -%}
            <div class="company-overview__exp-badge" aria-label="{{ section.settings.experience_number }} {{ section.settings.experience_label }}">
              <span class="company-overview__exp-number">{{ section.settings.experience_number }}</span>
              <span class="company-overview__exp-label">{{ section.settings.experience_label | default: 'Years of Excellence' }}</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Secondary accent image ─────────────────────────── {%- endcomment -%}
        {%- if section.settings.accent_image != blank -%}
          <div class="company-overview__accent-image-wrap">
            {{
              section.settings.accent_image
              | image_url: width: 320
              | image_tag:
                class: 'company-overview__accent-image',
                alt: section.settings.accent_image.alt | default: 'Manufacturing facility',
                loading: 'lazy',
                width: 320
            }}
          </div>
        {%- endif -%}

      </div>

      {%- comment -%} ── Right: Content Column ────────────────────────────── {%- endcomment -%}
      <div class="company-overview__content">

        {%- comment -%} Section header {%- endcomment -%}
        {%- render 'section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subtitle: section.settings.subtitle,
          heading_tag: 'h2',
          align: 'left'
        -%}

        {%- comment -%} ── Capability Highlights (icon blocks) ─────────────── {%- endcomment -%}
        {%- assign capability_blocks = section.blocks | where: 'type', 'capability' -%}
        {%- if capability_blocks.size > 0 -%}
          <div class="company-overview__capabilities">
            {%- for block in capability_blocks -%}
              <div
                class="company-overview__capability"
                data-animate="fade-up"
                data-delay="{{ forloop.index | times: 100 }}"
                {{ block.shopify_attributes }}
              >
                <div class="company-overview__capability-icon" aria-hidden="true">
                  {% render 'icon', name: block.settings.icon, size: 24 %}
                </div>
                <div class="company-overview__capability-text">
                  <strong class="company-overview__capability-title">{{ block.settings.title }}</strong>
                  <span class="company-overview__capability-desc">{{ block.settings.description }}</span>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} ── CTA Buttons ──────────────────────────────────────── {%- endcomment -%}
        <div class="company-overview__ctas" data-animate="fade-up" data-delay="300">
          {%- if section.settings.cta_primary_text != blank -%}
            <a
              href="{{ section.settings.cta_primary_url | default: '/pages/about' }}"
              class="btn btn--secondary"
              id="about-primary-cta"
            >
              {{ section.settings.cta_primary_text }}
              <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
            </a>
          {%- endif -%}

          {%- if section.settings.video_url != blank -%}
            <button
              class="btn btn--ghost company-overview__video-btn"
              data-video-url="{{ section.settings.video_url }}"
              data-video-modal
              type="button"
              aria-label="Watch our manufacturing video"
              id="about-video-btn"
            >
              <span class="company-overview__play-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="var(--color-primary)" opacity="0.1"/>
                  <polygon points="10 8 16 12 10 16 10 8" fill="var(--color-primary)"/>
                </svg>
              </span>
              {{ section.settings.video_cta_text | default: 'Watch our process' }}
            </button>
          {%- endif -%}
        </div>

      </div>
    </div>

    {%- comment -%} ── Timeline / Milestones ────────────────────────────────── {%- endcomment -%}
    {%- assign milestone_blocks = section.blocks | where: 'type', 'milestone' -%}
    {%- if milestone_blocks.size > 0 and section.settings.show_timeline -%}
      <div class="company-overview__timeline" aria-label="Company milestones">
        <div class="company-overview__timeline-header" data-animate="fade-up">
          <h3 class="company-overview__timeline-title">{{ section.settings.timeline_heading | default: 'Our Journey' }}</h3>
        </div>
        <div class="company-overview__timeline-track">
          <div class="company-overview__timeline-line" aria-hidden="true"></div>
          {%- for block in milestone_blocks -%}
            <div
              class="company-overview__milestone"
              data-animate="fade-up"
              data-delay="{{ forloop.index | times: 100 }}"
              {{ block.shopify_attributes }}
            >
              <div class="company-overview__milestone-dot" aria-hidden="true"></div>
              <div class="company-overview__milestone-card">
                <span class="company-overview__milestone-year">{{ block.settings.year }}</span>
                <p class="company-overview__milestone-event">{{ block.settings.event }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} ── Video Lightbox Modal ─────────────────────────────────────── {%- endcomment -%}
{%- if section.settings.video_url != blank -%}
<div
  class="video-modal overlay"
  id="video-modal-{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-label="Manufacturing process video"
  data-video-modal-container
>
  <div class="video-modal__box">
    <button
      class="video-modal__close"
      data-video-modal-close
      aria-label="Close video"
      type="button"
    >
      {% render 'icon', name: 'close', size: 24 %}
    </button>
    <div class="video-modal__embed" id="video-embed-{{ section.id }}"></div>
  </div>
</div>

<script>
(function() {
  var modal = document.getElementById('video-modal-{{ section.id }}');
  var embed = document.getElementById('video-embed-{{ section.id }}');
  var openBtns = document.querySelectorAll('[data-video-modal]');
  var closeBtn = modal ? modal.querySelector('[data-video-modal-close]') : null;

  function openModal(videoUrl) {
    if (!modal) return;
    // Convert YouTube/Vimeo URLs to embed format
    var embedUrl = videoUrl
      .replace('watch?v=', 'embed/')
      .replace('youtu.be/', 'youtube.com/embed/')
      .replace('vimeo.com/', 'player.vimeo.com/video/');

    embed.innerHTML = '<iframe src="' + embedUrl + '?autoplay=1&rel=0" frameborder="0" allowfullscreen allow="autoplay; encrypted-media" title="Manufacturing process video" style="width:100%;aspect-ratio:16/9;border-radius:8px;"></iframe>';
    modal.classList.add('is-active');
    document.body.classList.add('scroll-locked');
    closeBtn && closeBtn.focus();
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('is-active');
    document.body.classList.remove('scroll-locked');
    embed.innerHTML = '';
    openBtns[0] && openBtns[0].focus();
  }

  openBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      openModal(this.dataset.videoUrl);
    });
  });

  closeBtn && closeBtn.addEventListener('click', closeModal);
  modal && modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal();
  });
})();
</script>
{%- endif -%}

<style>
  /* =========================================================================
     COMPANY OVERVIEW
     ========================================================================= */

  .company-overview {
    overflow: hidden;
  }

  /* ── Main Grid: 2 column split ────────────────────────────────────────── */
  .company-overview__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
    margin-bottom: var(--space-20);
  }

  /* ── Media Column ─────────────────────────────────────────────────────── */
  .company-overview__media {
    position: relative;
  }

  .company-overview__image-wrap {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-2xl);
    aspect-ratio: 4 / 3;
  }

  .company-overview__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .company-overview__image-wrap:hover .company-overview__image {
    transform: scale(1.03);
  }

  /* Image placeholder */
  .company-overview__image-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-bg-section));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    color: var(--color-text-muted);
    border-radius: var(--radius-xl);
    font-size: var(--text-sm);
    border: 2px dashed var(--color-border);
  }

  .company-overview__placeholder-icon {
    color: var(--color-primary);
    opacity: 0.3;
  }

  /* Floating experience badge */
  .company-overview__exp-badge {
    position: absolute;
    bottom: -var(--space-6);
    right: -var(--space-6);
    bottom: -1.5rem;
    right: -1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 120px;
    height: 120px;
    background: linear-gradient(135deg, var(--color-accent), #e06c10);
    border-radius: 50%;
    text-align: center;
    padding: var(--space-4);
    box-shadow: var(--shadow-accent);
    border: 4px solid var(--color-white);
  }

  .company-overview__exp-number {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1;
  }

  .company-overview__exp-label {
    font-size: 0.6rem;
    font-weight: var(--font-weight-semibold);
    color: rgba(255,255,255,0.9);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.2;
    margin-top: 2px;
    text-align: center;
  }

  /* Secondary accent image */
  .company-overview__accent-image-wrap {
    position: absolute;
    top: -var(--space-8);
    left: -var(--space-8);
    top: -2rem;
    left: -2rem;
    width: 180px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 4px solid var(--color-white);
    display: none; /* Show only on large screens */
  }

  .company-overview__accent-image {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (min-width: 1200px) {
    .company-overview__accent-image-wrap {
      display: block;
    }
  }

  /* ── Content Column ───────────────────────────────────────────────────── */
  .company-overview__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* ── Capability Highlights ────────────────────────────────────────────── */
  .company-overview__capabilities {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .company-overview__capability {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: var(--color-bg-section);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: box-shadow var(--transition), border-color var(--transition), transform var(--transition);
  }

  .company-overview__capability:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary-light);
    transform: translateY(-2px);
  }

  .company-overview__capability-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    background-color: var(--color-primary-light);
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    transition: background-color var(--transition), color var(--transition);
  }

  .company-overview__capability:hover .company-overview__capability-icon {
    background-color: var(--color-primary);
    color: var(--color-white);
  }

  .company-overview__capability-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .company-overview__capability-title {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    line-height: var(--leading-snug);
  }

  .company-overview__capability-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── CTAs ─────────────────────────────────────────────────────────────── */
  .company-overview__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .company-overview__video-btn {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .company-overview__play-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    flex-shrink: 0;
    transition: background-color var(--transition);
  }

  .company-overview__video-btn:hover .company-overview__play-icon {
    background-color: var(--color-primary);
  }

  .company-overview__video-btn:hover .company-overview__play-icon svg polygon {
    fill: var(--color-white);
  }

  /* ── Timeline ─────────────────────────────────────────────────────────── */
  .company-overview__timeline {
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .company-overview__timeline-header {
    margin-bottom: var(--space-10);
    text-align: center;
  }

  .company-overview__timeline-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .company-overview__timeline-track {
    position: relative;
    display: flex;
    gap: 0;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: var(--space-8);
  }

  /* Horizontal connecting line */
  .company-overview__timeline-line {
    position: absolute;
    top: 0;
    left: 5%;
    right: 5%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-primary-light), var(--color-primary), var(--color-accent));
    border-radius: var(--radius-full);
  }

  .company-overview__milestone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    flex: 1;
    text-align: center;
    min-width: 0;
    padding-inline: var(--space-2);
  }

  .company-overview__milestone-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background-color: var(--color-primary);
    border: 3px solid var(--color-white);
    box-shadow: 0 0 0 3px var(--color-primary);
    flex-shrink: 0;
    margin-top: -7px;
    transition: background-color var(--transition), box-shadow var(--transition);
    position: relative;
    z-index: 1;
  }

  .company-overview__milestone:hover .company-overview__milestone-dot {
    background-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent);
  }

  .company-overview__milestone-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .company-overview__milestone-year {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }

  .company-overview__milestone-event {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ── Video Modal ─────────────────────────────────────────────────────── */
  .video-modal {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .video-modal__box {
    position: relative;
    width: 100%;
    max-width: 900px;
    background-color: #000;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-2xl);
    transform: scale(0.92);
    transition: transform var(--duration-base) var(--ease-spring);
  }

  .video-modal.is-active .video-modal__box {
    transform: scale(1);
  }

  .video-modal__close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: rgba(0,0,0,0.7);
    color: var(--color-white);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background-color var(--transition);
    padding: 0;
  }

  .video-modal__close:hover {
    background-color: var(--color-accent);
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .company-overview__grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
      margin-bottom: var(--space-12);
    }

    .company-overview__exp-badge {
      width: 100px;
      height: 100px;
    }

    .company-overview__exp-number {
      font-size: var(--text-2xl);
    }
  }

  @media (max-width: 767px) {
    .company-overview__capabilities {
      grid-template-columns: 1fr;
    }

    .company-overview__timeline-track {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .company-overview__timeline-line {
      display: none;
    }

    .company-overview__milestone {
      flex-direction: row;
      text-align: left;
      align-items: flex-start;
    }

    .company-overview__milestone-dot {
      margin-top: var(--space-1);
    }

    .company-overview__timeline-track::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 6px;
      width: 2px;
      background: linear-gradient(180deg, var(--color-primary), var(--color-accent));
    }

    .company-overview__milestone {
      padding-left: var(--space-8);
    }

    .company-overview__ctas {
      flex-direction: column;
      align-items: flex-start;
    }

    .company-overview__exp-badge {
      right: var(--space-4);
      bottom: var(--space-4);
      width: 90px;
      height: 90px;
    }
  }
</style>

{% schema %}
{
  "name": "Company Overview",
  "class": "section-company-overview",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "select",
      "id": "bg_style",
      "label": "Background style",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "alt",
          "label": "Light grey"
        }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "About Maxwell Automatic"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading",
      "default": "Built on Precision. Driven by Innovation."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Description",
      "default": "Maxwell Automatic is a premier manufacturer of Interactive Kiosks, Digital Signages, and Electrical Enclosures. Established in 2017 in Ahmedabad, we have grown to serve hospitals, government bodies, corporates, and smart city integrators across India."
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main image",
      "info": "Recommended: Factory / team photo. 800×600px or larger."
    },
    {
      "type": "image_picker",
      "id": "accent_image",
      "label": "Accent image (desktop only)",
      "info": "Small overlay image — e.g. product closeup. 320×240px."
    },
    {
      "type": "header",
      "content": "Experience Badge"
    },
    {
      "type": "text",
      "id": "experience_number",
      "label": "Years of experience",
      "default": "8+"
    },
    {
      "type": "text",
      "id": "experience_label",
      "label": "Badge label",
      "default": "Years of Excellence"
    },
    {
      "type": "header",
      "content": "CTA Buttons"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary button text",
      "default": "Company Profile"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link",
      "info": "Link to your company profile PDF page or About page"
    },
    {
      "type": "text",
      "id": "video_cta_text",
      "label": "Video button text",
      "default": "Watch our process"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video URL (YouTube or Vimeo)",
      "info": "Paste the full YouTube or Vimeo URL. Leave blank to hide the button.",
      "placeholder": "https://www.youtube.com/watch?v=..."
    },
    {
      "type": "header",
      "content": "Timeline"
    },
    {
      "type": "checkbox",
      "id": "show_timeline",
      "label": "Show milestones timeline",
      "default": true
    },
    {
      "type": "text",
      "id": "timeline_heading",
      "label": "Timeline section heading",
      "default": "Our Journey"
    }
  ],
  "blocks": [
    {
      "type": "capability",
      "name": "Capability highlight",
      "limit": 4,
      "settings": [
        {
