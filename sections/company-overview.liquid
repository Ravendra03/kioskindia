{%- comment -%}
  MAXWELL COMPANY OVERVIEW SECTION — PREMIUM EDITION
{%- endcomment -%}

{%- liquid
  assign capability_blocks = section.blocks | where: 'type', 'capability'
  assign milestone_blocks = section.blocks | where: 'type', 'milestone'
-%}

<section
  class="section{% if section.settings.bg_style == 'alt' %} section--alt{% endif %} company-overview"
  id="company-overview"
  aria-labelledby="company-overview-heading"
>
  <div class="container">

    <div class="company-overview__grid">

      {%- comment -%} Left Column: Image with Experience Badge {%- endcomment -%}
      <div class="company-overview__media" data-animate="fade-right">
        <div class="company-overview__image-wrap">
          {%- if section.settings.factory_image != blank -%}
            {{
              section.settings.factory_image
              | image_url: width: 900
              | image_tag:
                class: 'company-overview__image',
                alt: 'Maxwell Automatic Factory',
                loading: 'lazy',
                width: 900
            }}
          {%- else -%}
            <img
              src="{{ 'maxwell-factory.jpg' | asset_url }}"
              alt="Maxwell Automatic Manufacturing Plant - Vatwa GIDC"
              class="company-overview__image"
              loading="lazy"
              width="900"
              height="675"
            >
          {%- endif -%}

          {%- comment -%} Floating Experience Badge {%- endcomment -%}
          {%- if section.settings.experience_number != blank -%}
            <div class="company-overview__exp-badge" data-animate="zoom-in" data-delay="300">
              <span class="company-overview__exp-num">{{ section.settings.experience_number }}</span>
              <span class="company-overview__exp-label">{{ section.settings.experience_label | default: 'Years of Excellence' }}</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Right Column: Text & Capabilities {%- endcomment -%}
      <div class="company-overview__content" data-animate="fade-left">
        {%- render 'section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          subtitle: section.settings.subtitle,
          heading_tag: 'h2',
          align: 'left',
          section_id: 'company-overview-heading'
        -%}

        {%- if capability_blocks.size > 0 -%}
          <div class="company-overview__capabilities">
            {%- for block in capability_blocks -%}
              <div class="company-overview__cap-card" {{ block.shopify_attributes }}>
                <div class="company-overview__cap-icon" aria-hidden="true">
                  {% render 'icon', name: block.settings.icon, size: 24 %}
                </div>
                <div class="company-overview__cap-text">
                  <h3 class="company-overview__cap-title">{{ block.settings.title }}</h3>
                  <p class="company-overview__cap-desc">{{ block.settings.description }}</p>
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="company-overview__ctas" data-animate="fade-up" data-delay="300">
          {%- if section.settings.cta_primary_text != blank -%}
            <a
              href="{{ section.settings.cta_primary_url | default: '/pages/about' }}"
              class="btn btn--secondary"
              id="about-primary-cta"
            >
              {{ section.settings.cta_primary_text }}
              <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
            </a>
          {%- endif -%}

          {%- if section.settings.video_url != blank -%}
            <button
              class="btn btn--ghost company-overview__video-btn"
              data-video-url="{{ section.settings.video_url }}"
              data-video-modal
              type="button"
              aria-label="Watch our manufacturing video"
              id="about-video-btn"
            >
              <span class="company-overview__play-icon" aria-hidden="true">
                {% render 'icon', name: 'play', size: 18 %}
              </span>
              {{ section.settings.video_cta_text | default: 'Watch our process' }}
            </button>
          {%- endif -%}
        </div>
      </div>

    </div>

    {%- comment -%} Milestones Timeline {%- endcomment -%}
    {%- if section.settings.show_timeline and milestone_blocks.size > 0 -%}
      <div class="company-overview__timeline-wrap" data-animate="fade-up">
        <h3 class="company-overview__timeline-title">{{ section.settings.timeline_heading | default: 'Our Journey' }}</h3>
        <div class="company-overview__timeline">
          {%- for block in milestone_blocks -%}
            <div class="company-overview__milestone" {{ block.shopify_attributes }}>
              <div class="company-overview__milestone-node" aria-hidden="true"></div>
              <span class="company-overview__milestone-year">{{ block.settings.year }}</span>
              <p class="company-overview__milestone-event">{{ block.settings.event }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} Video Lightbox Modal {%- endcomment -%}
{%- if section.settings.video_url != blank -%}
  <div
    class="video-modal"
    id="video-modal-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-label="Manufacturing process video"
    data-video-modal-container
  >
    <div class="video-modal__box">
      <button
        class="video-modal__close"
        data-video-modal-close
        aria-label="Close video"
        type="button"
      >
        {% render 'icon', name: 'close', size: 24 %}
      </button>
      <div class="video-modal__embed" id="video-embed-{{ section.id }}"></div>
    </div>
  </div>
{%- endif -%}

<style>
  .company-overview__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .company-overview__image-wrap {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--color-border);
    aspect-ratio: 4 / 3;
    background-color: var(--color-bg-section);
  }

  .company-overview__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .company-overview__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    color: var(--color-primary);
    background: linear-gradient(135deg, var(--color-primary-light), rgba(245, 130, 32, 0.05));
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
  }

  .company-overview__exp-badge {
    position: absolute;
    bottom: var(--space-6);
    right: var(--space-6);
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: var(--color-white);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: var(--shadow-2xl);
    border: 2px solid rgba(255, 255, 255, 0.2);
  }

  .company-overview__exp-num {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1;
  }

  .company-overview__exp-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  /* Capabilities Grid */
  .company-overview__capabilities {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .company-overview__cap-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: var(--color-white);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .company-overview__cap-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .company-overview__cap-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .company-overview__cap-title {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0;
  }

  .company-overview__cap-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .company-overview__ctas {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .company-overview__video-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Timeline */
  .company-overview__timeline-wrap {
    margin-top: var(--space-16);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .company-overview__timeline-title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .company-overview__timeline {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-6);
    position: relative;
  }

  .company-overview__milestone {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  .company-overview__milestone-node {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-white), 0 0 0 6px var(--color-primary-light);
    margin-bottom: var(--space-3);
  }

  .company-overview__milestone-year {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .company-overview__milestone-event {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Modal */
  .video-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background-color: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition);
  }

  .video-modal.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .video-modal__box {
    position: relative;
    width: 100%;
    max-width: 900px;
    background-color: #000;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .video-modal__close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 2;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: var(--color-white);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  @media (max-width: 1024px) {
    .company-overview__grid {
      grid-template-columns: 1fr;
    }
    .company-overview__timeline {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  @media (max-width: 640px) {
    .company-overview__capabilities {
      grid-template-columns: 1fr;
    }
    .company-overview__timeline {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Company Overview",
  "class": "section-company-overview",
  "limit": 1,
  "settings": [
    {
      "type": "select",
      "id": "bg_style",
      "label": "Background style",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Light grey" }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "About Maxwell Automatic"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading",
      "default": "Built on Precision. Driven by Innovation."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section description",
      "default": "Maxwell Automatic is a premier manufacturer of Interactive Kiosks, Digital Signages, and Electrical Enclosures. Established in 2017 in Ahmedabad, we have grown to serve hospitals, government bodies, corporates, and smart city integrators across India."
    },
    {
      "type": "image_picker",
      "id": "factory_image",
      "label": "Factory / Facility image"
    },
    {
      "type": "text",
      "id": "experience_number",
      "label": "Experience badge number",
      "default": "8+"
    },
    {
      "type": "text",
      "id": "experience_label",
      "label": "Experience badge label",
      "default": "Years of Excellence"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary button text",
      "default": "Company Profile"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube or Vimeo video URL",
      "placeholder": "https://www.youtube.com/watch?v=..."
    },
    {
      "type": "text",
      "id": "video_cta_text",
      "label": "Video button text",
      "default": "Watch our process"
    },
    {
      "type": "header",
      "content": "Timeline Section"
    },
    {
      "type": "checkbox",
      "id": "show_timeline",
      "label": "Show journey timeline",
      "default": true
    },
    {
      "type": "text",
      "id": "timeline_heading",
      "label": "Timeline section heading",
      "default": "Our Journey"
    }
  ],
  "blocks": [
    {
      "type": "capability",
      "name": "Capability Highlight",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "factory", "label": "Factory" },
            { "value": "shield", "label": "Shield" },
            { "value": "cog", "label": "Cog" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "factory"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "In-House Manufacturing" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "End-to-end production at our Ahmedabad GIDC facility" }
      ]
    },
    {
      "type": "milestone",
      "name": "Timeline Milestone",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "2017" },
        { "type": "textarea", "id": "event", "label": "Event milestone", "default": "Company founded in Vatwa, Ahmedabad" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Company Overview",
      "settings": {
        "eyebrow": "About Maxwell Automatic",
        "heading": "Built on Precision. Driven by Innovation.",
        "subtitle": "Maxwell Automatic is a premier manufacturer of Interactive Kiosks, Digital Signages, and Electrical Enclosures. Established in 2017 in Ahmedabad, we have grown to serve hospitals, government bodies, corporates, and smart city integrators across India.",
        "experience_number": "8+",
        "experience_label": "Years of Excellence",
        "cta_primary_text": "Company Profile",
        "show_timeline": true
      },
      "blocks": [
        { "type": "capability", "settings": { "icon": "factory", "title": "In-House Manufacturing", "description": "End-to-end production at our Ahmedabad GIDC facility" } },
        { "type": "capability", "settings": { "icon": "shield", "title": "ISO Certified", "description": "Quality management systems meet international standards" } },
        { "type": "capability", "settings": { "icon": "cog", "title": "Custom Engineering", "description": "OEM & bespoke solutions engineered to spec" } },
        { "type": "capability", "settings": { "icon": "truck", "title": "Pan-India Delivery", "description": "Reliable logistics to 20+ states across India" } },
        { "type": "milestone", "settings": { "year": "2017", "event": "Company founded in Vatwa, Ahmedabad" } },
        { "type": "milestone", "settings": { "year": "2019", "event": "Launched interactive kiosk product line" } },
        { "type": "milestone", "settings": { "year": "2021", "event": "Crossed 100+ project milestone" } },
        { "type": "milestone", "settings": { "year": "2023", "event": "Expanded to digital signage & smart lockers" } },
        { "type": "milestone", "settings": { "year": "2025", "event": "500+ projects, 200+ clients across India" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
