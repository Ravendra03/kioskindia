{%- comment -%}
  MAXWELL CONTACT CTA & INQUIRY FORM SECTION — ENTERPRISE EDITION
{%- endcomment -%}

<section
  class="section contact-cta"
  id="contact-cta"
  aria-labelledby="contact-cta-heading"
>
  <div class="container">

    <div class="contact-cta__card" data-animate="fade-up">

      <div class="contact-cta__grid">

        {%- comment -%} Left Info Column {%- endcomment -%}
        <div class="contact-cta__info">
          <div class="eyebrow eyebrow--light">
            <span class="eyebrow__dot" aria-hidden="true"></span>
            {{ section.settings.eyebrow | default: "Get In Touch" }}
          </div>
          <h2 class="contact-cta__title" id="contact-cta-heading">{{ section.settings.heading | default: "Ready to Build Your Custom Solution?" }}</h2>
          <p class="contact-cta__desc">{{ section.settings.subtitle | default: "Send us your project specifications or request a custom quote from our engineering team." }}</p>

          <div class="contact-cta__details">
            {%- if settings.contact_phone != blank -%}
              <a href="tel:{{ settings.contact_phone_raw }}" class="contact-cta__item">
                <span class="contact-cta__icon" aria-hidden="true">{% render 'icon', name: 'phone', size: 20 %}</span>
                <div>
                  <strong class="contact-cta__label">Call Sales Direct</strong>
                  <span class="contact-cta__val">{{ settings.contact_phone }}</span>
                </div>
              </a>
            {%- endif -%}

            {%- if settings.contact_email != blank -%}
              <a href="mailto:{{ settings.contact_email }}" class="contact-cta__item">
                <span class="contact-cta__icon" aria-hidden="true">{% render 'icon', name: 'email', size: 20 %}</span>
                <div>
                  <strong class="contact-cta__label">Email Inquiry</strong>
                  <span class="contact-cta__val">{{ settings.contact_email }}</span>
                </div>
              </a>
            {%- endif -%}

            <div class="contact-cta__item">
              <span class="contact-cta__icon" aria-hidden="true">{% render 'icon', name: 'map-pin', size: 20 %}</span>
              <div>
                <strong class="contact-cta__label">Factory Unit</strong>
                <span class="contact-cta__val">{{ settings.contact_address_short | default: "Vatwa GIDC, Ahmedabad, Gujarat" }}</span>
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} Right Form Column {%- endcomment -%}
        <div class="contact-cta__form-wrap">
          {%- form 'contact', id: 'contact-cta-form', class: 'contact-cta__form' -%}
            {%- if form.posted_successfully? -%}
              <div class="alert alert--success" role="alert">
                {% render 'icon', name: 'check-circle', size: 20 %}
                <span>Thank you! Your inquiry has been submitted. Our engineering sales team will contact you within 24 hours.</span>
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="alert alert--error" role="alert">
                <span>Please check the highlighted fields and try again.</span>
              </div>
            {%- endif -%}

            <div class="form-grid">
              <div class="form-group">
                <label for="contact-name" class="form-label">Full Name *</label>
                <input type="text" id="contact-name" name="contact[name]" class="form-input" placeholder="Your Name" required>
              </div>

              <div class="form-group">
                <label for="contact-email" class="form-label">Business Email *</label>
                <input type="email" id="contact-email" name="contact[email]" class="form-input" placeholder="name@company.com" required>
              </div>

              <div class="form-group">
                <label for="contact-phone" class="form-label">Phone Number *</label>
                <input type="tel" id="contact-phone" name="contact[phone]" class="form-input" placeholder="+91 98765 43210" required>
              </div>

              <div class="form-group">
                <label for="contact-company" class="form-label">Company Name</label>
                <input type="text" id="contact-company" name="contact[company]" class="form-input" placeholder="Company Name">
              </div>

              <div class="form-group form-group--full">
                <label for="contact-message" class="form-label">Project Requirements / Specifications *</label>
                <textarea id="contact-message" name="contact[body]" class="form-textarea" rows="4" placeholder="Describe product type, quantity, and custom specifications required..." required></textarea>
              </div>
            </div>

            <button type="submit" class="btn btn--accent btn--lg contact-cta__submit">
              Submit RFP / Request Quote
              <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
            </button>
          {%- endform -%}
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .contact-cta__card {
    background: radial-gradient(circle at 10% 20%, #062B49 0%, #031C2F 100%);
    border-radius: var(--radius-xl, 20px);
    padding: clamp(2rem, 5vw, 4rem);
    color: var(--color-white);
    box-shadow: var(--shadow-xl);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .contact-cta__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-12);
    align-items: center;
  }

  .contact-cta__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-cta__title {
    font-size: clamp(2rem, 3vw, 3.2rem);
    font-weight: 800;
    color: var(--color-white);
    margin: 0;
    line-height: 1.15;
  }

  .contact-cta__desc {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.8);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .contact-cta__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .contact-cta__item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-white);
    text-decoration: none;
  }

  .contact-cta__icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-orange-accent, #F28C28);
    flex-shrink: 0;
  }

  .contact-cta__label {
    display: block;
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .contact-cta__val {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
  }

  /* Form Wrap */
  .contact-cta__form-wrap {
    background-color: var(--color-white);
    border-radius: var(--radius-lg, 16px);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-lg);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .form-group--full {
    grid-column: 1 / -1;
  }

  .contact-cta__submit {
    width: 100%;
    margin-top: var(--space-6);
  }

  @media (max-width: 1024px) {
    .contact-cta__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Contact CTA Form",
  "class": "section-contact-cta",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get In Touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Build Your Custom Solution?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Send us your project specifications or request a custom quote from our engineering team."
    }
  ],
  "presets": [
    {
      "name": "Contact CTA Form"
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
