          "category": "Kiosks",
          "badge": "Popular",
          "cta_text": "Explore Outdoor",
          "placeholder_icon": "factory"
        }
      }
    ]
  },
  "presets": [
    {
      "name": "Product Categories"
    }
  ]
}
{% endschema %}
