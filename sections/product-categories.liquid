            { "value": "factory", "label": "Factory" }
          ],
          "default": "package"
        }
      ]
    }
  ],
  "default": {
    "settings": {
      "eyebrow": "Our Product Range",
      "heading": "Engineered for Every Sector",
      "subtitle": "From interactive kiosks to smart enclosures — browse our full range of custom-built hardware solutions.",
      "show_filter_tabs": true,
      "filter_tabs": "Kiosks, Signage, Enclosures, Accessories",
      "cta_text": "View All Products"
    },
    "blocks": [
      {
        "type": "category",
        "settings": {
          "name": "Interactive Kiosks",
          "subtitle": "Self-service & information terminals",
