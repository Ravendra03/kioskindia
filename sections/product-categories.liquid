      },
      {
        "type": "category",
        "settings": {
          "name": "Electrical Enclosures",
          "subtitle": "MS, SS & GRP panel boxes",
          "description": "Powder-coated MS & stainless steel enclosures for industrial and OEM applications.",
          "category": "Enclosures",
          "product_count": "22 Products",
          "cta_text": "View Enclosures",
          "placeholder_icon": "package"
        }
      },
      {
        "type": "category",
        "settings": {
          "name": "Queue Management",
