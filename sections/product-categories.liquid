{%- comment -%}
  MAXWELL PRODUCT CATEGORIES SECTION — PREMIUM EDITION
{%- endcomment -%}

{%- liquid
  assign category_blocks = section.blocks | where: 'type', 'category'
  assign all_tabs = section.settings.filter_tabs | split: ','
-%}

<section
  class="section product-categories"
  id="product-categories"
  style="background-color: #FFFFFF;"
  aria-labelledby="categories-heading"
>
  <div class="container">

    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtitle: section.settings.subtitle,
      heading_tag: 'h2',
      align: 'center',
      theme: 'light',
      section_id: 'categories-heading'
    -%}

    {%- comment -%} Filter Tabs Bar {%- endcomment -%}
    {%- if section.settings.show_filter_tabs and all_tabs.size > 0 -%}
      <div
        class="product-categories__tabs"
        role="tablist"
        aria-label="Filter product categories"
        data-animate="fade-up"
      >
        <button
          class="product-categories__tab is-active"
          role="tab"
          aria-selected="true"
          data-filter="all"
        >
          All Range
          <span class="product-categories__tab-badge">{{ category_blocks.size }}</span>
        </button>

        {%- for tab in all_tabs -%}
          {%- assign tab_clean = tab | strip -%}
          {%- assign tab_handle = tab_clean | handleize -%}
          {%- assign tab_count = 0 -%}
          {%- for block in category_blocks -%}
            {%- assign block_cat_handle = block.settings.category | handleize -%}
            {%- if block_cat_handle == tab_handle -%}
              {%- assign tab_count = tab_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if tab_count > 0 -%}
            <button
              class="product-categories__tab"
              role="tab"
              aria-selected="false"
              data-filter="{{ tab_handle }}"
            >
              {{ tab_clean }}
              <span class="product-categories__tab-badge">{{ tab_count }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Categories Grid {%- endcomment -%}
    {%- if category_blocks.size > 0 -%}
      <div class="product-categories__grid" data-animate="fade-up" data-delay="100">
        {%- for block in category_blocks -%}
          {%- assign category_handle = block.settings.category | default: 'kiosks' | handleize -%}
          <article
            class="product-categories__card{% if block.settings.featured %} product-categories__card--featured{% endif %}"
            data-category="{{ category_handle }}"
            {{ block.shopify_attributes }}
          >
            <div class="product-categories__card-image-wrap">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag:
                    class: 'product-categories__card-img',
                    alt: block.settings.name,
                    loading: 'lazy',
                    width: 700
                }}
              {%- else -%}
                <div class="product-categories__card-placeholder" aria-hidden="true">
                  {%- assign icon_name = block.settings.placeholder_icon | default: 'package' -%}
                  {% render 'icon', name: icon_name, size: 48 %}
                </div>
              {%- endif -%}

              {%- if block.settings.badge != blank -%}
                <span class="badge badge--accent product-categories__badge">
                  {{ block.settings.badge }}
                </span>
              {%- endif -%}

              {%- if block.settings.product_count != blank -%}
                <span class="product-categories__count-pill">
                  {{ block.settings.product_count }}
                </span>
              {%- endif -%}
            </div>

            <div class="product-categories__card-body">
              <span class="product-categories__card-category">{{ block.settings.category }}</span>
              <h3 class="product-categories__card-title">{{ block.settings.name }}</h3>

              {%- if block.settings.subtitle != blank -%}
                <p class="product-categories__card-subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}

              <p class="product-categories__card-desc">{{ block.settings.description }}</p>

              <div class="product-categories__card-footer">
                <a
                  href="{{ block.settings.link | default: '/collections/all' }}"
                  class="btn btn--primary btn--sm"
                >
                  {{ block.settings.cta_text | default: 'Explore Category' }}
                  <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 16 %}</span>
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .product-categories {
    background-color: var(--color-surface-base, #000000) !important;
    position: relative;
    z-index: 1;
  }

  .product-categories .section-header {
    margin-bottom: var(--space-4);
  }
  .product-categories__tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-1);
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
    background-color: var(--color-bg-section, #F7F9FB);
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border, #DDE4EA);
    width: fit-content;
    margin-inline: auto;
  }

  .product-categories__tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.6rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: color var(--transition), background-color var(--transition), box-shadow var(--transition);
  }

  .product-categories__tab:hover {
    color: var(--color-primary);
  }

  .product-categories__tab.is-active {
    color: var(--color-text-primary, #171717);
    background: var(--color-text-inverse, #e0a580);
    box-shadow: var(--shadow-1);
  }

  .product-categories__tab-badge {
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-full);
    background-color: rgba(0, 0, 0, 0.08);
    line-height: 1;
  }

  .product-categories__tab.is-active .product-categories__tab-badge {
    background-color: rgba(255, 255, 255, 0.2);
    color: var(--color-white);
  }

  /* Grid */
  .product-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .product-categories__card {
    background-color: var(--color-text-primary, #171717);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md, 25px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-1);
    transition: transform var(--transition), border-color var(--transition);
  }

  .product-categories__card:hover {
    transform: translateY(-4px);
    border-color: var(--color-text-inverse, #e0a580);
  }

  .product-categories__card-image-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 150px;
    background-color: var(--color-bg-section);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-categories__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .product-categories__card:hover .product-categories__card-img {
    transform: scale(1.06);
  }

  .product-categories__card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.35;
    padding: var(--space-4);
  }

  .product-categories__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    font-size: 0.65rem;
    padding: 0.2rem 0.5rem;
  }

  .product-categories__count-pill {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    font-size: 0.7rem;
    font-weight: var(--font-weight-semibold);
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
    color: var(--color-white);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .product-categories__card-body {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .product-categories__card-category {
    font-size: 0.68rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .product-categories__card-title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0;
    line-height: 1.25;
  }

  .product-categories__card-subtitle {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .product-categories__card-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    margin-top: 0.35rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-categories__card-footer {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 1024px) {
    .product-categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .product-categories__grid {
      grid-template-columns: 1fr;
    }
    .product-categories__tabs {
      border-radius: var(--radius-lg);
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Product Categories",
  "class": "section-product-categories",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Our Product Range"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading",
      "default": "Engineered for Every Sector"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "From interactive kiosks to smart enclosures — browse our full range of custom-built hardware solutions."
    },
    {
      "type": "checkbox",
      "id": "show_filter_tabs",
      "label": "Show category filter tabs",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_tabs",
      "label": "Filter tabs (comma separated)",
      "default": "Kiosks, Signage, Enclosures, Accessories"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Interactive Kiosks" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Self-service & information terminals" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Touch-enabled kiosks for airports, hospitals, retail, banks, and government offices." },
        { "type": "text", "id": "category", "label": "Category tag for filtering", "default": "Kiosks" },
        { "type": "text", "id": "product_count", "label": "Product count pill", "default": "18 Products" },
        { "type": "text", "id": "badge", "label": "Badge label (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "placeholder_icon", "label": "Placeholder icon", "options": [
          { "value": "monitor", "label": "Monitor" },
          { "value": "package", "label": "Package" },
          { "value": "factory", "label": "Factory" },
          { "value": "layers", "label": "Layers" }
        ], "default": "monitor" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Explore Kiosks" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Categories",
      "settings": {
        "eyebrow": "Our Product Range",
        "heading": "Engineered for Every Sector",
        "subtitle": "From interactive kiosks to smart enclosures — browse our full range of custom-built hardware solutions.",
        "show_filter_tabs": true,
        "filter_tabs": "Kiosks, Signage, Enclosures, Accessories"
      },
      "blocks": [
        { "type": "category", "settings": { "name": "Interactive Kiosks", "subtitle": "Self-service & information terminals", "description": "Touch-enabled kiosks for airports, hospitals, retail, banks, and government offices.", "category": "Kiosks", "product_count": "18 Products", "cta_text": "Explore Kiosks", "placeholder_icon": "monitor" } },
        { "type": "category", "settings": { "name": "Digital Signage", "subtitle": "Indoor & outdoor display solutions", "description": "High-brightness LED & LCD signage for malls, transit hubs, and corporate offices.", "category": "Signage", "product_count": "14 Products", "cta_text": "Explore Signage", "placeholder_icon": "monitor" } },
        { "type": "category", "settings": { "name": "Smart Lockers", "subtitle": "Secure storage & parcel systems", "description": "Automated locker systems for offices, universities, and e-commerce last-mile delivery.", "category": "Kiosks", "badge": "New", "cta_text": "View Lockers", "placeholder_icon": "package" } },
        { "type": "category", "settings": { "name": "Electrical Enclosures", "subtitle": "MS, SS & GRP panel boxes", "description": "Powder-coated MS & stainless steel enclosures for industrial and OEM applications.", "category": "Enclosures", "product_count": "22 Products", "cta_text": "View Enclosures", "placeholder_icon": "package" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
