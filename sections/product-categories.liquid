{%- comment -%}
  MAXWELL PRODUCT CATEGORIES SECTION
  ─────────────────────────────────────────────────────────────────────────────
  Features:
  - Tab filter: All | Kiosks | Signage | Enclosures | Accessories
  - Masonry-style responsive card grid
  - Card hover overlay with description + CTA
  - Product count badge on each card
  - Animated filter transition (fade + scale)
  - Block-based: each card is a Theme Editor block
  - "View all products" section CTA
  - Fully accessible: keyboard navigable tabs
  ─────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- liquid
  assign category_blocks = section.blocks | where: 'type', 'category'
  assign all_tabs = section.settings.filter_tabs | split: ','
-%}

<section
  class="section section--alt product-categories"
  id="product-categories"
  aria-labelledby="product-categories-heading"
>
  <div class="container">

    {%- comment -%} ── Section Header ──────────────────────────────────────── {%- endcomment -%}
    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtitle: section.settings.subtitle,
      heading_tag: 'h2',
      align: 'center',
      section_id: 'product-categories-heading'
    -%}

    {%- comment -%} ── Filter Tabs ─────────────────────────────────────────── {%- endcomment -%}
    {%- if section.settings.show_filter_tabs and category_blocks.size > 0 -%}
      <div
        class="product-categories__tabs"
        role="tablist"
        aria-label="Filter product categories"
        data-animate="fade-up"
        data-delay="200"
      >
        {%- comment -%} "All" tab — always present {%- endcomment -%}
        <button
          class="product-categories__tab is-active"
          role="tab"
          aria-selected="true"
          aria-controls="product-categories-grid"
          data-filter="all"
          id="tab-all"
          type="button"
        >
          All
          <span class="product-categories__tab-count">{{ category_blocks.size }}</span>
        </button>

        {%- comment -%} Dynamic tabs from comma-separated settings value {%- endcomment -%}
        {%- for tab in all_tabs -%}
          {%- assign tab_clean = tab | strip -%}
          {%- assign tab_handle = tab_clean | handleize -%}
          {%- comment -%} Count blocks that match this tab {%- endcomment -%}
          {%- assign tab_count = 0 -%}
          {%- for block in category_blocks -%}
            {%- if block.settings.category | handleize == tab_handle -%}
              {%- assign tab_count = tab_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if tab_count > 0 -%}
            <button
              class="product-categories__tab"
              role="tab"
              aria-selected="false"
              data-filter="{{ tab_handle }}"
              id="tab-{{ tab_handle }}"
              type="button"
            >
              {{ tab_clean }}
              <span class="product-categories__tab-count">{{ tab_count }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Category Cards Grid ─────────────────────────────────── {%- endcomment -%}
    <div
      class="product-categories__grid"
      id="product-categories-grid"
      role="tabpanel"
      aria-label="Product categories"
      data-animate="fade-up"
      data-delay="300"
    >
      {%- if category_blocks.size > 0 -%}
        {%- for block in category_blocks -%}
          {%- if block.type == 'category' -%}
            {%- assign cat_handle = block.settings.category | handleize -%}
            <div
              class="product-categories__card{% if block.settings.featured %} product-categories__card--featured{% endif %}"
              data-category="{{ cat_handle }}"
              data-animate-card
              {{ block.shopify_attributes }}
            >
              {%- comment -%} Card image {%- endcomment -%}
              <div class="product-categories__card-image">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 700
                    | image_tag:
                      class: 'product-categories__card-img',
                      alt: block.settings.name,
                      loading: 'lazy',
                      width: 700
                  }}
                {%- else -%}
                  <div class="product-categories__card-placeholder" aria-hidden="true">
                    {% render 'icon', name: block.settings.placeholder_icon | default: 'package', size: 48 %}
                  </div>
                {%- endif -%}

                {%- comment -%} Badge: product count or custom label {%- endcomment -%}
                {%- if block.settings.badge != blank -%}
                  <span class="badge badge--accent product-categories__badge">
                    {{ block.settings.badge }}
                  </span>
                {%- elsif block.settings.product_count != blank -%}
                  <span class="badge badge--outline product-categories__badge">
                    {{ block.settings.product_count }}
                  </span>
                {%- endif -%}

                {%- comment -%} Hover overlay {%- endcomment -%}
                <div class="product-categories__overlay">
                  <div class="product-categories__overlay-content">
                    {%- if block.settings.description != blank -%}
                      <p class="product-categories__overlay-desc">{{ block.settings.description }}</p>
                    {%- endif -%}
                    <a
                      href="{{ block.settings.link | default: '/collections/all' }}"
                      class="btn btn--outline-white btn--sm"
                      tabindex="-1"
                    >
                      {{ block.settings.cta_text | default: 'Explore' }}
                      {% render 'icon', name: 'arrow-right', size: 16 %}
                    </a>
                  </div>
                </div>
              </div>

              {%- comment -%} Card footer {%- endcomment -%}
              <div class="product-categories__card-footer">
                <div class="product-categories__card-info">
                  <a href="{{ block.settings.link | default: '/collections/all' }}" class="product-categories__card-name">
                    {{ block.settings.name }}
                  </a>
                  {%- if block.settings.subtitle != blank -%}
                    <span class="product-categories__card-subtitle">{{ block.settings.subtitle }}</span>
                  {%- endif -%}
                </div>
                <a
                  href="{{ block.settings.link | default: '/collections/all' }}"
                  class="product-categories__card-arrow"
                  aria-label="View {{ block.settings.name }}"
                  tabindex="-1"
                >
                  {% render 'icon', name: 'arrow-right', size: 20 %}
                </a>
              </div>

            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Empty state for Theme Editor {%- endcomment -%}
        <p class="product-categories__empty">
          Add product category blocks using the Theme Editor to display cards here.
        </p>
      {%- endif -%}
    </div>

    {%- comment -%} ── Section Footer CTA ───────────────────────────────────── {%- endcomment -%}
    {%- if section.settings.cta_text != blank -%}
      <div class="product-categories__footer" data-animate="fade-up">
        <a
          href="{{ section.settings.cta_url | default: '/collections/all' }}"
          class="btn btn--secondary btn--lg"
          id="product-categories-cta"
        >
          {{ section.settings.cta_text }}
          <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
(function() {
  var section = document.getElementById('product-categories');
  if (!section) return;

  var tabs = section.querySelectorAll('.product-categories__tab');
  var cards = section.querySelectorAll('.product-categories__card');

  function filterCards(filter) {
    cards.forEach(function(card) {
      var match = filter === 'all' || card.dataset.category === filter;
      if (match) {
        card.style.display = '';
        requestAnimationFrame(function() {
          card.style.opacity = '1';
          card.style.transform = 'scale(1) translateY(0)';
        });
      } else {
        card.style.opacity = '0';
        card.style.transform = 'scale(0.95) translateY(8px)';
        setTimeout(function() {
          if (card.style.opacity === '0') card.style.display = 'none';
        }, 250);
      }
    });
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      // Update active state
      tabs.forEach(function(t) {
        t.classList.remove('is-active');
        t.setAttribute('aria-selected', 'false');
      });
      this.classList.add('is-active');
      this.setAttribute('aria-selected', 'true');

      filterCards(this.dataset.filter);
    });

    // Keyboard: left/right arrow nav
    tab.addEventListener('keydown', function(e) {
      var tabArr = Array.from(tabs);
      var idx = tabArr.indexOf(this);
      if (e.key === 'ArrowRight') {
        tabArr[(idx + 1) % tabArr.length].focus();
        tabArr[(idx + 1) % tabArr.length].click();
      } else if (e.key === 'ArrowLeft') {
        tabArr[(idx - 1 + tabArr.length) % tabArr.length].focus();
        tabArr[(idx - 1 + tabArr.length) % tabArr.length].click();
      }
    });
  });

  // Set initial transition on all cards
  cards.forEach(function(card) {
    card.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
  });
})();
</script>

<style>
  /* =========================================================================
     PRODUCT CATEGORIES
     ========================================================================= */

  .product-categories {
    overflow: hidden;
  }

  /* ── Filter Tabs ──────────────────────────────────────────────────────── */
  .product-categories__tabs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-10);
    margin-bottom: var(--space-10);
    padding: var(--space-2);
    background-color: var(--color-white);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    width: fit-content;
    margin-inline: auto;
  }

  .product-categories__tab {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    font-family: inherit;
    color: var(--color-text-muted);
    background: none;
    border: none;
    border-radius: var(--radius-full);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--transition), color var(--transition), box-shadow var(--transition);
  }

  .product-categories__tab:hover {
    color: var(--color-primary);
    background-color: var(--color-primary-light);
  }

  .product-categories__tab.is-active {
    background-color: var(--color-primary);
    color: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .product-categories__tab.is-active:hover {
    background-color: var(--color-secondary);
  }

  .product-categories__tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    font-size: 0.65rem;
    font-weight: var(--font-weight-bold);
    border-radius: var(--radius-full);
    background-color: rgba(255,255,255,0.2);
    line-height: 1;
  }

  .product-categories__tab:not(.is-active) .product-categories__tab-count {
    background-color: var(--color-border);
    color: var(--color-text-muted);
  }

  /* ── Cards Grid ───────────────────────────────────────────────────────── */
  .product-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  /* Featured card spans 2 columns */
  .product-categories__card--featured {
    grid-column: span 2;
  }

  /* ── Individual Card ─────────────────────────────────────────────────── */
  .product-categories__card {
    background-color: var(--color-white);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    transition:
      box-shadow var(--transition),
      border-color var(--transition),
      transform var(--transition);
    display: flex;
    flex-direction: column;
  }

  .product-categories__card:hover {
    box-shadow: var(--shadow-xl);
    border-color: transparent;
    transform: translateY(-4px);
  }

  /* ── Card Image Wrapper ──────────────────────────────────────────────── */
  .product-categories__card-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    flex-shrink: 0;
  }

  .product-categories__card--featured .product-categories__card-image {
    aspect-ratio: 16 / 9;
  }

  .product-categories__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .product-categories__card:hover .product-categories__card-img {
    transform: scale(1.06);
  }

  /* Placeholder */
  .product-categories__card-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-bg-section));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    opacity: 0.4;
  }

  /* Badge */
  .product-categories__badge {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    z-index: 2;
  }

  /* ── Hover Overlay ────────────────────────────────────────────────────── */
  .product-categories__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 51, 102, 0.92) 0%,
      rgba(0, 51, 102, 0.5) 50%,
      transparent 100%
    );
    display: flex;
    align-items: flex-end;
    padding: var(--space-6);
    opacity: 0;
    transition: opacity var(--transition);
  }

  .product-categories__card:hover .product-categories__overlay {
    opacity: 1;
  }

  .product-categories__overlay-content {
    transform: translateY(10px);
    transition: transform var(--transition);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .product-categories__card:hover .product-categories__overlay-content {
    transform: translateY(0);
  }

  .product-categories__overlay-desc {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.9);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ── Card Footer ──────────────────────────────────────────────────────── */
  .product-categories__card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-5);
    gap: var(--space-3);
    border-top: 1px solid var(--color-border);
    flex: 1;
  }

  .product-categories__card-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .product-categories__card-name {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-categories__card-name:hover {
    color: var(--color-primary);
  }

  .product-categories__card-subtitle {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-categories__card-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background-color: var(--color-bg-section);
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    text-decoration: none;
    transition: background-color var(--transition), color var(--transition), transform var(--transition);
  }

  .product-categories__card:hover .product-categories__card-arrow {
    background-color: var(--color-primary);
    color: var(--color-white);
    transform: translateX(2px);
  }

  /* ── Empty State ─────────────────────────────────────────────────────── */
  .product-categories__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: var(--space-16);
    color: var(--color-text-muted);
    font-size: var(--text-base);
    background-color: var(--color-bg-section);
    border-radius: var(--radius-lg);
    border: 2px dashed var(--color-border);
  }

  /* ── Footer CTA ───────────────────────────────────────────────────────── */
  .product-categories__footer {
    margin-top: var(--space-12);
    text-align: center;
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 1200px) {
    .product-categories__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .product-categories__card--featured {
      grid-column: span 2;
    }
  }

  @media (max-width: 767px) {
    .product-categories__grid {
      grid-template-columns: 1fr;
    }
    .product-categories__card--featured {
      grid-column: span 1;
    }
    .product-categories__tabs {
      border-radius: var(--radius-xl);
      width: 100%;
    }
    .product-categories__tab {
      padding: var(--space-2) var(--space-3);
      font-size: var(--text-xs);
    }
  }
</style>

{% schema %}
{
  "name": "Product Categories",
  "class": "section-product-categories",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Our Product Range"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading",
      "default": "Engineered for Every Sector"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "From interactive kiosks to smart enclosures — browse our full range of custom-built hardware solutions."
    },
    {
      "type": "header",
      "content": "Filter Tabs"
    },
    {
      "type": "checkbox",
      "id": "show_filter_tabs",
      "label": "Show filter tabs",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_tabs",
      "label": "Filter tab labels",
      "default": "Kiosks, Signage, Enclosures, Accessories",
      "info": "Comma-separated. Must match the 'Category' value set on each card block."
    },
    {
      "type": "header",
      "content": "Footer CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Product category card",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Recommended: 700×525px. JPG for performance."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Category name",
          "default": "Interactive Kiosks",
          "placeholder": "Interactive Kiosks"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Card subtitle",
          "default": "Self-service & information kiosks",
          "placeholder": "Self-service terminals"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Hover description",
          "default": "Custom-built touch-screen kiosks for airports, hospitals, retail, and government.",
          "info": "Shown on card hover overlay"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Filter category (must match a filter tab)",
          "default": "Kiosks",
          "info": "Enter exactly as one of the filter tab values e.g. 'Kiosks'"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product count badge",
          "placeholder": "12 Products",
          "info": "Optional. e.g. '12 Products'"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Accent badge text (overrides count)",
          "placeholder": "Best Seller",
          "info": "Optional highlight label e.g. 'New', 'Popular'"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured card (wider on desktop)",
          "default": false
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Overlay button text",
          "default": "Explore Range"
        },
        {
          "type": "url",
