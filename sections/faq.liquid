{%- comment -%}
  MAXWELL ACCORDION FAQ SECTION
  ─────────────────────────────────────────────────────────────────────────────
  Features:
  - Accessible native accordion toggles (`<details>` / `<summary>`)
  - FAQPage JSON-LD schema generated automatically for Google Rich Snippets
  - Fully editable via Theme Customizer blocks
  ─────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}

<section
  class="section section--alt faq-section"
  id="faq"
  aria-labelledby="faq-heading"
>
  <div class="container">

    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtitle: section.settings.subtitle,
      heading_tag: 'h2',
      align: 'center',
      section_id: 'faq-heading'
    -%}

    {%- if faq_blocks.size > 0 -%}
      <div class="faq__container" data-animate="fade-up">
        {%- for block in faq_blocks -%}
          <details class="faq__item" {{ block.shopify_attributes }}>
            <summary class="faq__question">
              <span>{{ block.settings.question }}</span>
              <span class="faq__chevron" aria-hidden="true">
                {% render 'icon', name: 'chevron-down', size: 20 %}
              </span>
            </summary>
            <div class="faq__answer">
              <p>{{ block.settings.answer }}</p>
            </div>
          </details>
        {%- endfor -%}
      </div>

      {%- comment -%} Structured Data for FAQPage Schema {%- endcomment -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in faq_blocks -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | json }}
              }
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
      </script>
    {%- endif -%}

  </div>
</section>

<style>
  .faq__container {
    max-width: 840px;
    margin: var(--space-8) auto 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq__item {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .faq__item[open] {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .faq__question {
    padding: var(--space-5) var(--space-6);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__chevron {
    color: var(--color-text-muted);
    transition: transform var(--duration-base) var(--ease-out);
    display: flex;
    flex-shrink: 0;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq__answer {
    padding: 0 var(--space-6) var(--space-6) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .faq__answer p {
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "FAQ Accordion",
  "class": "section-faq",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Everything You Need to Know"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Answers to common questions regarding customization, MOQ, delivery times, and warranty."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is the typical manufacturing lead time for custom kiosks?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Standard kiosk models take 2–3 weeks. Custom engineered OEM projects take approximately 3–4 weeks from technical design sign-off."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "What is the typical manufacturing lead time for custom kiosks?",
            "answer": "Standard kiosk models take 2–3 weeks. Custom engineered OEM projects take approximately 3–4 weeks from technical design sign-off."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you provide on-site installation and support across India?",
            "answer": "Yes, we offer complete pan-India freight delivery with optional on-site installation, software integration support, and commissioning."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can kiosks be customized with our company logo and brand color powder coating?",
            "answer": "Absolutely. All kiosk enclosures can be custom powder coated in any RAL color shade and customized with laser-etched or vinyl brand logos."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What warranty and post-sales support do you offer?",
            "answer": "All Maxwell products come with a 1-year comprehensive hardware warranty, extendable up to 3 years under an Annual Maintenance Contract (AMC)."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "*"
    ]
  }
}
{% endschema %}
