{%- comment -%}
  MAXWELL CLIENTS / TRUST LOGO MARQUEE SECTION
  ─────────────────────────────────────────────────────────────────────────────
  Features:
  - Infinite smooth scrolling logo ticker / marquee
  - Supports client logo images and text fallback
  - Fully responsive and performant (CSS marquee)
  ─────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- assign client_blocks = section.blocks | where: 'type', 'client' -%}

<section
  class="section clients-marquee"
  id="clients-partners"
  aria-labelledby="clients-heading"
>
  <div class="container">

    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtitle: section.settings.subtitle,
      heading_tag: 'h2',
      align: 'center',
      section_id: 'clients-heading'
    -%}

    {%- if client_blocks.size > 0 -%}
      <div class="marquee" data-animate="fade-up">
        <div class="marquee__track">
          {%- comment -%} Loop twice for smooth infinite marquee effect {%- endcomment -%}
          {%- for i in (1..2) -%}
            {%- for block in client_blocks -%}
              <div class="marquee__item" {{ block.shopify_attributes }}>
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 240
                    | image_tag:
                      class: 'marquee__logo',
                      alt: block.settings.name | default: 'Client Logo',
                      loading: 'lazy',
                      width: 120
                  }}
                {%- else -%}
                  <span class="marquee__text">{{ block.settings.name }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .clients-marquee {
    overflow: hidden;
    padding-block: var(--space-16);
  }

  .marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin-top: var(--space-8);
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    width: max-content;
    animation: marqueeScroll 25s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 60px;
    padding-inline: var(--space-4);
    filter: grayscale(100%);
    opacity: 0.65;
    transition: filter var(--transition), opacity var(--transition);
  }

  .marquee__item:hover {
    filter: grayscale(0%);
    opacity: 1;
  }

  .marquee__logo {
    max-height: 44px;
    width: auto;
    object-fit: contain;
  }

  .marquee__text {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    white-space: nowrap;
  }

  @keyframes marqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>

{% schema %}
