{%- comment -%}
  MAXWELL INDUSTRIES SECTION
  ─────────────────────────────────────────────────────────────────────────────
  Features:
  - Dark premium background (navy gradient)
  - 8-tile industry grid with icon + name + hover glow
  - Optional client/project count per industry
  - Optional industry stat bar (total industries, states, years)
  - Each tile is a block editable from Theme Editor
  - Decorative background grid pattern
  - Accessible: each tile is a link with proper aria-label
  ─────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- assign industry_blocks = section.blocks | where: 'type', 'industry' -%}
{%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}

<section
  class="section industries"
  id="industries-served"
  aria-labelledby="industries-heading"
>

  {%- comment -%} Decorative BG elements {%- endcomment -%}
  <div class="industries__bg" aria-hidden="true">
    <div class="industries__bg-glow industries__bg-glow--1"></div>
    <div class="industries__bg-glow industries__bg-glow--2"></div>
  </div>

  <div class="container">

    {%- comment -%} ── Section Header ──────────────────────────────────────── {%- endcomment -%}
    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtitle: section.settings.subtitle,
      heading_tag: 'h2',
      align: 'center',
      theme: 'dark',
      section_id: 'industries-heading'
    -%}

    {%- comment -%} ── Stats Bar ───────────────────────────────────────────── {%- endcomment -%}
    {%- if stat_blocks.size > 0 and section.settings.show_stats -%}
      <div class="industries__stats" data-animate="fade-up" data-delay="100">
        {%- for block in stat_blocks -%}
          <div class="industries__stat" {{ block.shopify_attributes }}>
            <span class="industries__stat-number">
              <span
                data-counter="{{ block.settings.number }}"
                data-suffix="{{ block.settings.suffix }}"
                data-duration="1800"
              >{{ block.settings.number }}{{ block.settings.suffix }}</span>
            </span>
            <span class="industries__stat-label">{{ block.settings.label }}</span>
          </div>
          {%- unless forloop.last -%}
            <div class="industries__stat-divider" aria-hidden="true"></div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Industry Tiles Grid ─────────────────────────────────── {%- endcomment -%}
    {%- if industry_blocks.size > 0 -%}
      <div
        class="industries__grid"
        role="list"
        aria-label="Industries we serve"
        data-animate="fade-up"
        data-delay="200"
      >
        {%- for block in industry_blocks -%}
          <div
            class="industries__tile-wrapper"
            role="listitem"
            data-animate="fade-up"
            data-delay="{{ forloop.index | times: 50 | plus: 200 }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="industries__tile"
                aria-label="{{ block.settings.name }}: {{ block.settings.description }}"
              >
            {%- else -%}
              <div class="industries__tile" tabindex="0">
            {%- endif -%}

              <div class="industries__tile-icon" aria-hidden="true">
                {%- if block.settings.icon != blank -%}
                  {% render 'icon', name: block.settings.icon, size: 36 %}
                {%- endif -%}
              </div>

              <div class="industries__tile-content">
                <span class="industries__tile-name">{{ block.settings.name }}</span>
                {%- if block.settings.description != blank -%}
                  <span class="industries__tile-desc">{{ block.settings.description }}</span>
                {%- endif -%}
                {%- if block.settings.project_count != blank -%}
                  <span class="industries__tile-count">{{ block.settings.project_count }}</span>
                {%- endif -%}
              </div>

              <div class="industries__tile-arrow" aria-hidden="true">
                {% render 'icon', name: 'arrow-right', size: 16 %}
              </div>

              <div class="industries__tile-glow" aria-hidden="true"></div>

            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="industries__empty">Add industry blocks from the Theme Editor to populate this section.</p>
    {%- endif -%}

    {%- comment -%} ── Section CTA ─────────────────────────────────────────── {%- endcomment -%}
    {%- if section.settings.cta_text != blank -%}
      <div class="industries__cta" data-animate="fade-up">
        <a
          href="{{ section.settings.cta_url | default: '/pages/contact' }}"
          class="btn btn--outline-white btn--lg"
          id="industries-cta"
        >
          {{ section.settings.cta_text }}
          <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  /* =========================================================================
     INDUSTRIES
     ========================================================================= */

  .industries {
    position: relative;
    background: linear-gradient(
      145deg,
      #001a33 0%,
      var(--color-primary) 40%,
      var(--color-secondary) 80%,
      #001a33 100%
    );
    overflow: hidden;
  }

  /* Override section padding for dark sections */
  .industries.section {
    padding-block: var(--space-20);
  }

  /* ── Background Decorations ────────────────────────────────────────────── */
  .industries__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .industries__bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.15;
  }

  .industries__bg-glow--1 {
    width: 600px;
    height: 600px;
    background: var(--color-accent);
    top: -200px;
    right: -200px;
  }

  .industries__bg-glow--2 {
    width: 400px;
    height: 400px;
    background: rgba(255, 255, 255, 0.3);
    bottom: -150px;
    left: -100px;
  }

  /* Ensure content sits above bg */
  .industries .container {
    position: relative;
    z-index: var(--z-raised);
  }

  /* ── Section header dark overrides ────────────────────────────────────── */
  .industries .eyebrow {
    border-color: rgba(245, 130, 32, 0.4);
    background-color: rgba(245, 130, 32, 0.12);
  }

  /* ── Stats Bar ───────────────────────────────────────────────────────── */
  .industries__stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    padding: var(--space-6) var(--space-8);
    margin-bottom: var(--space-14);
    width: fit-content;
    margin-inline: auto;
    backdrop-filter: blur(10px);
  }

  .industries__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding-inline: var(--space-10);
    text-align: center;
  }

  .industries__stat-number {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
  }

  .industries__stat-label {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    white-space: nowrap;
  }

  .industries__stat-divider {
    width: 1px;
    height: 48px;
    background-color: rgba(255, 255, 255, 0.15);
    flex-shrink: 0;
  }

  /* ── Industries Grid ─────────────────────────────────────────────────── */
  .industries__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-14);
  }

  /* ── Industry Tile ───────────────────────────────────────────────────── */
  .industries__tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    text-decoration: none;
    cursor: pointer;
    overflow: hidden;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
    backdrop-filter: blur(8px);
  }

  .industries__tile:hover,
  .industries__tile:focus-visible {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(245, 130, 32, 0.5);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(245, 130, 32, 0.2);
    outline: none;
  }

  .industries__tile:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Glow effect on hover */
  .industries__tile-glow {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xl);
    background: radial-gradient(
      ellipse at 50% 0%,
      rgba(245, 130, 32, 0.15) 0%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--transition);
  }

  .industries__tile:hover .industries__tile-glow {
    opacity: 1;
  }

  /* Icon */
  .industries__tile-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background-color: rgba(245, 130, 32, 0.15);
    border-radius: var(--radius-md);
    color: var(--color-accent);
    flex-shrink: 0;
    transition: background-color var(--transition), color var(--transition);
    position: relative;
    z-index: 1;
  }

  .industries__tile:hover .industries__tile-icon {
    background-color: var(--color-accent);
    color: var(--color-white);
  }

  /* Content */
  .industries__tile-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .industries__tile-name {
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-white);
    line-height: var(--leading-snug);
  }

  .industries__tile-desc {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
    line-height: var(--leading-relaxed);
  }

  .industries__tile-count {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.65rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: var(--space-1);
  }

  /* Arrow indicator */
  .industries__tile-arrow {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    color: rgba(255, 255, 255, 0.3);
    transition: color var(--transition), transform var(--transition);
    z-index: 1;
  }

  .industries__tile:hover .industries__tile-arrow {
    color: var(--color-accent);
    transform: translate(3px, -3px);
  }

  /* ── CTA ─────────────────────────────────────────────────────────────── */
  .industries__cta {
    text-align: center;
    margin-top: var(--space-4);
  }

  /* ── Empty State ─────────────────────────────────────────────────────── */
  .industries__empty {
    text-align: center;
    color: rgba(255, 255, 255, 0.5);
    padding: var(--space-12);
    border: 2px dashed rgba(255,255,255,0.15);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-10);
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .industries__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .industries__stat {
      padding-inline: var(--space-6);
    }
  }

  @media (max-width: 767px) {
    .industries__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3);
    }
    .industries__stats {
      flex-wrap: wrap;
      gap: var(--space-4);
      padding: var(--space-5) var(--space-6);
    }
    .industries__stat {
      padding-inline: var(--space-4);
    }
    .industries__stat-divider {
      display: none;
    }
    .industries__tile {
      padding: var(--space-5);
    }
  }

  @media (max-width: 480px) {
    .industries__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3);
    }
    .industries__tile-icon {
      width: 46px;
      height: 46px;
    }
    .industries__tile-name {
      font-size: var(--text-sm);
    }
    .industries__tile-arrow {
      display: none;
    }
  }
</style>

{% schema %}
