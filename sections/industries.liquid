{%- comment -%}
  MAXWELL INDUSTRIES SECTION — DARK LUXURY EDITION
{%- endcomment -%}

{%- liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign industry_blocks = section.blocks | where: 'type', 'industry'
-%}

<section
  class="section section--dark industries-section"
  id="industries"
  aria-labelledby="industries-heading"
>
  <div class="container">

    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtitle: section.settings.subtitle,
      heading_tag: 'h2',
      align: 'center',
      dark: true,
      section_id: 'industries-heading'
    -%}

    {%- comment -%} Stats Counter Bar {%- endcomment -%}
    {%- if section.settings.show_stats and stat_blocks.size > 0 -%}
      <div class="industries__stats" data-animate="fade-up">
        {%- for block in stat_blocks -%}
          <div class="industries__stat-item" {{ block.shopify_attributes }}>
            <span
              class="industries__stat-number"
              data-counter="{{ block.settings.number }}"
              data-suffix="{{ block.settings.suffix }}"
            >
              0
            </span>
            <span class="industries__stat-label">{{ block.settings.label }}</span>
          </div>
          {%- unless forloop.last -%}
            <div class="industries__stat-divider" aria-hidden="true"></div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Industry Tiles Grid {%- endcomment -%}
    {%- if industry_blocks.size > 0 -%}
      <div class="industries__grid" data-animate="fade-up" data-delay="100">
        {%- for block in industry_blocks -%}
          <div
            class="industry-tile"
            data-animate="zoom-in"
            data-delay="{{ forloop.index | times: 50 }}"
            {{ block.shopify_attributes }}
          >
            <div class="industry-tile__icon-wrap" aria-hidden="true">
              {% render 'icon', name: block.settings.icon, size: 28 %}
            </div>

            <div class="industry-tile__content">
              <h3 class="industry-tile__name">{{ block.settings.name }}</h3>
              <p class="industry-tile__desc">{{ block.settings.description }}</p>
              {%- if block.settings.project_count != blank -%}
                <span class="industry-tile__count">{{ block.settings.project_count }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Bottom CTA {%- endcomment -%}
    {%- if section.settings.cta_text != blank -%}
      <div class="industries__cta-wrap" data-animate="fade-up" data-delay="300">
        <a
          href="{{ section.settings.cta_url | default: '/pages/contact' }}"
          class="btn btn--primary btn--lg industries-cta-btn"
          id="industries-cta"
        >
          {{ section.settings.cta_text }}
          <span class="btn__icon" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .industries-section {
    background-color: #000000 !important;
    padding-block: clamp(3.5rem, 6vw, 6rem);
    position: relative;
    overflow: hidden;
  }

  .industries__stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48px;
    background-color: #171717;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 24px 32px;
    margin-bottom: 48px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .industries__stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
  }

  .industries__stat-number {
    font-size: 2.2rem;
    font-weight: 800;
    color: #E51D48;
    line-height: 1;
  }

  .industries__stat-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.8);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .industries__stat-divider {
    width: 1px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.12);
  }

  /* Industry Grid */
  .industries__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .industry-tile {
    background-color: #171717;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .industry-tile:hover {
    transform: translateY(-6px);
    border-color: #E51D48;
    box-shadow: 0 16px 36px rgba(229, 29, 72, 0.2);
  }

  .industry-tile__icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: #242424;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #E51D48;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .industry-tile:hover .industry-tile__icon-wrap {
    background-color: #E51D48;
    color: #FFFFFF;
    transform: scale(1.08);
  }

  .industry-tile__content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .industry-tile__name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.3;
  }

  .industry-tile__desc {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    line-height: 1.45;
  }

  .industry-tile__count {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #E51D48;
    background-color: rgba(229, 29, 72, 0.12);
    padding: 0.25rem 0.65rem;
    border-radius: 50px;
    width: fit-content;
    margin-top: 8px;
  }

  .industries__cta-wrap {
    text-align: center;
    margin-top: 48px;
  }

  .industries-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.85rem 2rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #FFFFFF !important;
    background-color: #E51D48 !important;
    border: none !important;
    border-radius: 50px !important;
    box-shadow: 0 4px 16px rgba(229, 29, 72, 0.35);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .industries-cta-btn:hover {
    background-color: #C4143B !important;
    transform: translateY(-2px);
  }

  .industry-tile__desc {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.4;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .industry-tile__count {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    margin-top: var(--space-2);
  }

  .industries__cta-wrap {
    margin-top: var(--space-12);
    text-align: center;
  }

  @media (max-width: 1024px) {
    .industries__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .industries__grid {
      grid-template-columns: 1fr;
    }
    .industries__stats {
      flex-direction: column;
      gap: var(--space-4);
    }
    .industries__stat-divider {
      width: 60px;
      height: 1px;
    }
  }
</style>

{% schema %}
{
  "name": "Industries Served",
  "class": "section-industries",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Industries We Serve"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading",
      "default": "Powering India's Key Sectors"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Our solutions are deployed across India's most demanding environments — from smart hospitals to government offices and transit hubs."
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show stats bar above tiles",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Discuss Your Project"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat counter",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "8" },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Industries Served" }
      ]
    },
    {
      "type": "industry",
      "name": "Industry tile",
      "limit": 12,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "hospital", "label": "Healthcare / Hospital" },
            { "value": "building", "label": "Government / Civic" },
            { "value": "bus", "label": "Transportation / Transit" },
            { "value": "city", "label": "Retail / Malls" },
            { "value": "graduation-cap", "label": "Education / Campus" },
            { "value": "globe", "label": "Hospitality / Hotels" },
            { "value": "factory", "label": "Manufacturing / Industrial" },
            { "value": "shield", "label": "Banking & Financial Services" }
          ],
          "default": "hospital"
        },
        { "type": "text", "id": "name", "label": "Industry name", "default": "Healthcare" },
        { "type": "textarea", "id": "description", "label": "Short description", "default": "Patient self-registration kiosks, OPD token display systems." },
        { "type": "text", "id": "project_count", "label": "Project count badge (optional)", "default": "80+ Projects" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Industries Served",
      "settings": {
        "eyebrow": "Industries We Serve",
        "heading": "Powering India's Key Sectors",
        "subtitle": "Our solutions are deployed across India's most demanding environments — from smart hospitals to government offices and transit hubs.",
        "show_stats": true,
        "cta_text": "Discuss Your Project"
      },
      "blocks": [
        { "type": "stat", "settings": { "number": "8", "suffix": "+", "label": "Industries Served" } },
        { "type": "stat", "settings": { "number": "20", "suffix": "+", "label": "States Covered" } },
        { "type": "stat", "settings": { "number": "500", "suffix": "+", "label": "Installations" } },
        { "type": "industry", "settings": { "icon": "hospital", "name": "Healthcare", "description": "Patient kiosks, OPD tokens, wayfinding signage", "project_count": "80+ Projects" } },
        { "type": "industry", "settings": { "icon": "building", "name": "Government", "description": "Citizen service kiosks, e-governance terminals", "project_count": "60+ Projects" } },
        { "type": "industry", "settings": { "icon": "bus", "name": "Transportation", "description": "Metro kiosks, bus terminal displays, ATVM", "project_count": "40+ Projects" } },
        { "type": "industry", "settings": { "icon": "city", "name": "Retail & Malls", "description": "Wayfinding, self-checkout, digital advertising", "project_count": "70+ Projects" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
