      "info": "Set up your menu in Navigation. Nested items create mega menu dropdowns."
    },
    {
      "type": "checkbox",
      "id": "transparent_on_hero",
      "label": "Transparent header over hero section",
      "default": true
    },
    {
      "type": "header",
      "content": "Top Info Bar"
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "Show top bar (desktop only)",
      "default": true
    },
    {
      "type": "text",
      "id": "topbar_badge_1",
      "label": "Trust badge 1",
      "default": "ISO Certified"
    },
    {
      "type": "text",
      "id": "topbar_badge_2",
      "label": "Trust badge 2",
      "default": "Make in India"
    },
    {
      "type": "text",
      "id": "topbar_badge_3",
      "label": "Trust badge 3",
      "default": "MSME Registered"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder text",
      "default": "Search kiosks, signages, enclosures…"
    }
  ],
  "blocks": [
    {
      "type": "mega_menu_feature",
      "name": "Mega menu featured image",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Exact menu item name",
          "info": "Must match the nav link title exactly (case-sensitive)",
          "placeholder": "Products"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Featured image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge label (optional)",
          "placeholder": "New Arrival"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Card heading",
          "placeholder": "Interactive Kiosks"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA link text",
          "placeholder": "Explore range"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        }
      ]
    }
  ],
  "default": {
    "settings": {
      "show_topbar": true,
      "transparent_on_hero": true,
      "cta_text": "Request a Quote",
      "topbar_badge_1": "ISO Certified",
      "topbar_badge_2": "Make in India",
      "topbar_badge_3": "MSME Registered",
      "logo_width": 160
    }
  },
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
