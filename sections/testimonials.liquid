{%- comment -%}
  MAXWELL TESTIMONIALS SECTION
  ─────────────────────────────────────────────────────────────────────────────
  Features:
  - Customer review cards with 5-star ratings, author title, and company logo
  - Grid layout with responsive slider/stacking
  - Fully editable via Theme Customizer blocks
  ─────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- assign testimonial_blocks = section.blocks | where: 'type', 'testimonial' -%}

<section
  class="section{% if section.settings.bg_style == 'alt' %} section--alt{% endif %} testimonials"
  id="testimonials"
  aria-labelledby="testimonials-heading"
>
  <div class="container">

    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtitle: section.settings.subtitle,
      heading_tag: 'h2',
      align: 'center',
      section_id: 'testimonials-heading'
    -%}

    {%- if testimonial_blocks.size > 0 -%}
      <div class="testimonials__grid">
        {%- for block in testimonial_blocks -%}
          <div
            class="testimonial-card"
            data-animate="fade-up"
            data-delay="{{ forloop.index | times: 100 }}"
            {{ block.shopify_attributes }}
          >
            <div class="testimonial-card__header">
              <div class="testimonial-card__stars" aria-label="5 out of 5 stars">
                {%- for i in (1..5) -%}
                  {% render 'icon', name: 'star', size: 16 %}
                {%- endfor -%}
              </div>
              <div class="testimonial-card__quote-icon" aria-hidden="true">
                {% render 'icon', name: 'quote', size: 24 %}
              </div>
            </div>

            <blockquote class="testimonial-card__quote">
              "{{ block.settings.quote }}"
            </blockquote>

            <div class="testimonial-card__author">
              {%- if block.settings.avatar != blank -%}
                {{
                  block.settings.avatar
                  | image_url: width: 100
                  | image_tag:
                    class: 'testimonial-card__avatar',
                    alt: block.settings.author_name,
                    loading: 'lazy',
                    width: 48,
                    height: 48
                }}
              {%- else -%}
                <div class="testimonial-card__avatar-placeholder">
                  {{ block.settings.author_name | slice: 0, 1 }}
                </div>
              {%- endif -%}

              <div class="testimonial-card__meta">
                <strong class="testimonial-card__name">{{ block.settings.author_name }}</strong>
                <span class="testimonial-card__title">{{ block.settings.author_title }}</span>
                {%- if block.settings.company != blank -%}
                  <span class="testimonial-card__company">{{ block.settings.company }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .testimonial-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .testimonial-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .testimonial-card__stars {
    display: flex;
    gap: 2px;
    color: #f59e0b;
  }

  .testimonial-card__quote-icon {
    color: var(--color-primary);
    opacity: 0.2;
  }

  .testimonial-card__quote {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    font-style: italic;
    margin: 0;
    flex: 1;
  }

  .testimonial-card__author {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .testimonial-card__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .testimonial-card__avatar-placeholder {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-primary-light);
    color: var(--color-primary);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .testimonial-card__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial-card__name {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .testimonial-card__title {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .testimonial-card__company {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "class": "section-testimonials",
  "limit": 1,
  "settings": [
    {
      "type": "select",
      "id": "bg_style",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Light Grey" }
      ],
      "default": "alt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Client Reviews"
