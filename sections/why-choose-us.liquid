        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% In-House Production"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Laser cutting, CNC bending, powder coating, and final assembly all under one roof in Vatwa GIDC."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        {
          "type": "usp",
          "settings": {
            "icon": "factory",
            "title": "100% In-House Production",
            "description": "Complete manufacturing control from raw metal sheets to finished kiosk assembly at our Vatwa unit."
          }
        },
        {
          "type": "usp",
          "settings": {
            "icon": "shield",
