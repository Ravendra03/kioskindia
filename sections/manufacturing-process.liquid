{%- comment -%}
  MAXWELL MANUFACTURING PROCESS SECTION — PREMIUM EDITION
{%- endcomment -%}

{%- assign step_blocks = section.blocks | where: 'type', 'step' -%}

<section
  class="section{% if section.settings.bg_style == 'alt' %} section--alt{% endif %} mfg-process"
  id="manufacturing-process"
  aria-labelledby="process-heading"
>
  <div class="container">

    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      subtitle: section.settings.subtitle,
      heading_tag: 'h2',
      align: 'center',
      section_id: 'process-heading'
    -%}

    {%- if step_blocks.size > 0 -%}

      <div class="mfg-process__steps" role="list">

        <div class="mfg-process__connector" aria-hidden="true">
          <div class="mfg-process__connector-progress"></div>
        </div>

        {%- for block in step_blocks -%}
          <div
            class="mfg-process__step"
            role="listitem"
            data-animate="fade-up"
            data-delay="{{ forloop.index | times: 100 }}"
            {{ block.shopify_attributes }}
          >
            <div class="mfg-process__step-number" aria-hidden="true">
              <span class="mfg-process__step-num-inner">{{ forloop.index }}</span>
            </div>

            <div class="mfg-process__step-icon" aria-hidden="true">
              {% render 'icon', name: block.settings.icon, size: 28 %}
            </div>

            <div class="mfg-process__step-content">
              <h3 class="mfg-process__step-title">{{ block.settings.title }}</h3>
              <p class="mfg-process__step-desc">{{ block.settings.description }}</p>
              {%- if block.settings.duration != blank -%}
                <span class="mfg-process__step-duration">
                  {% render 'icon', name: 'clock', size: 12 %}
                  {{ block.settings.duration }}
                </span>
              {%- endif -%}
            </div>

          </div>

          {%- unless forloop.last -%}
            <div class="mfg-process__arrow" aria-hidden="true">
              {% render 'icon', name: 'chevron-right', size: 18 %}
            </div>
          {%- endunless -%}

        {%- endfor -%}
      </div>

      {%- if section.settings.show_guarantee -%}
        <div class="mfg-process__guarantee" data-animate="fade-up" data-delay="500">
          <div class="mfg-process__guarantee-icon" aria-hidden="true">
            {% render 'icon', name: 'shield', size: 28 %}
          </div>
          <div class="mfg-process__guarantee-content">
            <strong class="mfg-process__guarantee-title">{{ section.settings.guarantee_title | default: 'Quality Guarantee' }}</strong>
            <span class="mfg-process__guarantee-text">{{ section.settings.guarantee_text }}</span>
          </div>
          {%- if section.settings.guarantee_cta_text != blank -%}
            <a
              href="{{ section.settings.guarantee_cta_url | default: '/pages/contact' }}"
              class="btn btn--primary btn--sm mfg-process__guarantee-cta"
            >
              {{ section.settings.guarantee_cta_text }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    {%- endif -%}

  </div>
</section>

<style>
  .mfg-process {
    overflow: hidden;
  }

  .mfg-process__steps {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0;
    margin-top: var(--space-6);
    padding-top: var(--space-6);
  }

  .mfg-process__connector {
    position: absolute;
    top: calc(var(--space-6) + 28px);
    left: 5%;
    right: 5%;
    height: 3px;
    background-color: var(--color-border);
    border-radius: var(--radius-full);
    z-index: 0;
    overflow: hidden;
  }

  .mfg-process__connector-progress {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    border-radius: var(--radius-full);
    transition: width 1.5s var(--ease-out);
  }

  .mfg-process__connector-progress.is-animated {
    width: 100%;
  }

  .mfg-process__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    flex: 1;
    min-width: 0;
    padding-inline: var(--space-2);
    position: relative;
    z-index: 1;
  }

  .mfg-process__step-number {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0F4C81 0%, #001A33 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: inset 0 2px 5px rgba(255, 255, 255, 0.45), inset 0 -3px 6px rgba(0, 0, 0, 0.6), 0 0 0 6px var(--color-white), 0 8px 18px -2px rgba(0, 51, 102, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.3);
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease, background 0.3s ease;
  }

  .mfg-process__step:hover .mfg-process__step-number {
    background: linear-gradient(135deg, #F58220 0%, #003366 100%);
    box-shadow: inset 0 2px 5px rgba(255, 255, 255, 0.6), inset 0 -3px 6px rgba(0, 0, 0, 0.4), 0 0 0 6px var(--color-white), 0 12px 24px -3px rgba(245, 130, 32, 0.5);
    transform: translateY(-3px) scale(1.1);
  }

  .mfg-process__step-num-inner {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1;
  }

  .mfg-process__step-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background-color: var(--color-primary-light);
    border-radius: var(--radius-lg);
    color: var(--color-primary);
    transition: background-color var(--transition), color var(--transition), transform var(--transition);
  }

  .mfg-process__step:hover .mfg-process__step-icon {
    background-color: var(--color-primary);
    color: var(--color-white);
    transform: rotate(-6deg) scale(1.05);
  }

  .mfg-process__step-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mfg-process__step-title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0;
  }

  .mfg-process__step-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .mfg-process__step-duration {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.7rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    background-color: rgba(245, 130, 32, 0.1);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    width: fit-content;
    margin-inline: auto;
  }

  .mfg-process__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    flex-shrink: 0;
    padding-top: calc(var(--space-6) + 18px);
    opacity: 0.4;
  }

  /* Guarantee Bar */
  .mfg-process__guarantee {
    margin-top: var(--space-12);
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-8);
    background: linear-gradient(135deg, var(--color-primary-light), rgba(245, 130, 32, 0.05));
    border: 1px solid var(--color-primary-light);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-md);
  }

  .mfg-process__guarantee-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background-color: var(--color-primary);
    border-radius: var(--radius-lg);
    color: var(--color-white);
    flex-shrink: 0;
  }

  .mfg-process__guarantee-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .mfg-process__guarantee-title {
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .mfg-process__guarantee-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .mfg-process__steps {
      flex-wrap: wrap;
      gap: var(--space-6);
      justify-content: center;
    }
    .mfg-process__connector,
    .mfg-process__arrow {
      display: none;
    }
    .mfg-process__step {
      flex: 0 1 calc(50% - var(--space-6));
    }
  }

  @media (max-width: 640px) {
    .mfg-process__steps {
      flex-direction: column;
      align-items: stretch;
    }
    .mfg-process__step {
      flex: 1;
      flex-direction: row;
      text-align: left;
      align-items: flex-start;
      padding-block: var(--space-4);
      border-bottom: 1px solid var(--color-border);
    }
    .mfg-process__step-content {
      align-items: flex-start;
    }
    .mfg-process__guarantee {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Manufacturing Process",
  "class": "section-mfg-process",
  "limit": 1,
  "settings": [
    {
      "type": "select",
      "id": "bg_style",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "alt", "label": "Light grey" }
      ],
      "default": "alt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "How We Work"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading",
      "default": "From Concept to Installation"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Our proven 6-step process ensures every project is delivered on time, within budget, and built to last."
    },
    {
      "type": "checkbox",
      "id": "show_guarantee",
      "label": "Show guarantee bar below steps",
      "default": true
    },
    {
      "type": "text",
      "id": "guarantee_title",
      "label": "Guarantee title",
      "default": "Maxwell Quality Guarantee"
    },
    {
      "type": "textarea",
      "id": "guarantee_text",
      "label": "Guarantee description",
      "default": "Every product ships with a minimum 1-year comprehensive warranty, post-installation support, and a dedicated account manager for enterprise clients."
    },
    {
      "type": "text",
      "id": "guarantee_cta_text",
      "label": "Guarantee button text",
      "default": "Contact Our Team"
    },
    {
      "type": "url",
      "id": "guarantee_cta_url",
      "label": "Guarantee button link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "headphones", "label": "Consultation" },
            { "value": "settings", "label": "Design / Engineering" },
            { "value": "check-circle", "label": "Approval / Review" },
            { "value": "factory", "label": "Manufacturing" },
            { "value": "shield", "label": "Quality Testing" },
            { "value": "cog", "label": "Installation" }
          ],
          "default": "headphones"
        },
        { "type": "text", "id": "title", "label": "Step title", "default": "Consultation" },
        { "type": "textarea", "id": "description", "label": "Step description", "default": "We understand your requirements and recommend the right solution." },
        { "type": "text", "id": "duration", "label": "Duration label", "default": "Day 1–2" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manufacturing Process",
      "settings": {
        "bg_style": "alt",
        "eyebrow": "How We Work",
        "heading": "From Concept to Installation",
        "subtitle": "Our proven 6-step process ensures every project is delivered on time, within budget, and built to last.",
        "show_guarantee": true,
        "guarantee_title": "Maxwell Quality Guarantee",
        "guarantee_text": "Every product ships with a minimum 1-year comprehensive warranty, post-installation support, and a dedicated account manager for enterprise clients.",
        "guarantee_cta_text": "Contact Our Team"
      },
      "blocks": [
        { "type": "step", "settings": { "icon": "headphones", "title": "Consultation", "description": "Share your requirements. Our team responds within 24 hours.", "duration": "Day 1–2" } },
        { "type": "step", "settings": { "icon": "settings", "title": "Design & Engineering", "description": "We design and engineer a custom solution matched to your specifications.", "duration": "Day 3–7" } },
        { "type": "step", "settings": { "icon": "check-circle", "title": "Approval", "description": "Design drawings and bill of materials submitted for your sign-off.", "duration": "Day 7–10" } },
        { "type": "step", "settings": { "icon": "factory", "title": "Manufacturing", "description": "In-house production at our Ahmedabad facility with real-time tracking.", "duration": "Day 10–25" } },
        { "type": "step", "settings": { "icon": "shield", "title": "Quality Testing", "description": "Rigorous QA/QC: functional, safety, and endurance testing before dispatch.", "duration": "Day 25–28" } },
        { "type": "step", "settings": { "icon": "cog", "title": "Delivery & Installation", "description": "Pan-India delivery with optional on-site installation and commissioning.", "duration": "Day 28–32" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["*"] }
}
{% endschema %}
