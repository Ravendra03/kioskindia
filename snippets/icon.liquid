{%- comment -%}
  MAXWELL ICON SYSTEM
  Usage: {% render 'icon', name: 'phone', class: 'icon--sm', aria_label: 'Phone' %}
  Parameters:
    - name:       (required) icon identifier
    - class:      (optional) additional CSS classes
    - aria_label: (optional) ARIA label for standalone icons
    - size:       (optional) width/height in px, default 24
{%- endcomment -%}

{%- assign icon_size = size | default: 24 -%}
{%- assign icon_class = 'icon' -%}
{%- if class != blank -%}
  {%- assign icon_class = 'icon ' | append: class -%}
{%- endif -%}

{%- if aria_label != blank -%}
  {%- assign aria_attrs = 'role="img" aria-label="' | append: aria_label | append: '"' -%}
{%- else -%}
  {%- assign aria_attrs = 'aria-hidden="true" focusable="false"' -%}
{%- endif -%}

{%- case name -%}

