{%- comment -%}
  MAXWELL DESIGN SYSTEM — CSS VARIABLES & TOKENS
  Injected into <head> via layout/theme.liquid
{%- endcomment -%}

<style>
  :root {
    /* ── Colors ────────────────────────────────────────────────────────────── */
    --color-primary: {{ settings.color_primary | default: '#001F3F' }};
    --color-primary-dark: #001226;
    --color-primary-light: #F0F6FF;
    --color-secondary: {{ settings.color_secondary | default: '#004C99' }};
    --color-accent: {{ settings.color_accent | default: '#0088FF' }};
    --color-accent-hover: #0066CC;
    --color-accent-light: rgba(0, 136, 255, 0.12);
    --color-gold: #F59E0B;
    --color-steel: #64748B;
    --color-steel-light: #F1F5F9;
    --color-bg-page: {{ settings.color_bg | default: '#FFFFFF' }};
    --color-bg-section: {{ settings.color_bg_alt | default: '#F8FAFC' }};
    --color-bg-dark: #001730;
    --color-bg-dark-alt: #000F20;
    --color-text: {{ settings.color_text | default: '#0F172A' }};
    --color-text-muted: {{ settings.color_text_muted | default: '#475569' }};
    --color-text-light: #94A3B8;
    --color-white: #FFFFFF;
    --color-border: #E2E8F0;
    --color-border-dark: rgba(255, 255, 255, 0.14);

    /* ── Typography ────────────────────────────────────────────────────────── */
    --font-heading: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
    --font-weight-extrabold: 800;

    /* Modular Fluid Typography Scale (1.25 ratio) */
    --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.8125rem);
    --text-sm: clamp(0.85rem, 0.82rem + 0.15vw, 0.875rem);
    --text-base: clamp(0.95rem, 0.92rem + 0.2vw, 1rem);
    --text-lg: clamp(1.1rem, 1.05rem + 0.3vw, 1.15rem);
    --text-xl: clamp(1.25rem, 1.15rem + 0.5vw, 1.35rem);
    --text-2xl: clamp(1.5rem, 1.35rem + 0.8vw, 1.75rem);
    --text-3xl: clamp(1.85rem, 1.6rem + 1.2vw, 2.25rem);
    --text-4xl: clamp(2.25rem, 1.9rem + 1.8vw, 2.85rem);
    --text-5xl: clamp(2.75rem, 2.2rem + 2.8vw, 3.75rem);

    --leading-tight: 1.15;
    --leading-snug: 1.25;
    --leading-normal: 1.5;
    --leading-relaxed: 1.65;

    --tracking-tight: -0.025em;
    --tracking-normal: 0;
    --tracking-wide: 0.025em;
    --tracking-wider: 0.05em;
    --tracking-widest: 0.1em;

    /* ── Strict 8px Spatial Grid System ───────────────────────────────────── */
    --space-1: 0.5rem;   /* 8px */
    --space-2: 1rem;     /* 16px */
    --space-3: 1.5rem;   /* 24px */
    --space-4: 2rem;     /* 32px */
    --space-5: 2.5rem;   /* 40px */
    --space-6: 3rem;     /* 48px */
    --space-8: 4rem;     /* 64px */
    --space-10: 5rem;    /* 80px */
    --space-12: 6rem;    /* 96px */
    --space-16: 8rem;    /* 128px */

    /* ── Layout ────────────────────────────────────────────────────────────── */
    --container-width: {{ settings.container_width | default: 1280 }}px;
    --container-padding: clamp(1rem, 3vw, 2rem);

    /* ── Border Radius Scale ────────────────────────────────────────────────── */
    --radius-xs: 4px;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --radius-2xl: 32px;
    --radius-full: 9999px;

    /* ── Layered Elevation Shadows ────────────────────────────────────────── */
    --shadow-sm: 0 2px 4px rgba(0, 31, 64, 0.03), 0 1px 2px rgba(0, 31, 64, 0.02);
    --shadow-md: 0 6px 16px -2px rgba(0, 31, 64, 0.06), 0 2px 6px -1px rgba(0, 31, 64, 0.03);
    --shadow-lg: 0 12px 28px -4px rgba(0, 31, 64, 0.09), 0 4px 10px -2px rgba(0, 31, 64, 0.04);
    --shadow-xl: 0 20px 45px -6px rgba(0, 51, 102, 0.13), 0 8px 20px -4px rgba(0, 31, 64, 0.05);
    --shadow-2xl: 0 32px 64px -12px rgba(0, 31, 64, 0.22);
    --shadow-glow: 0 0 30px rgba(0, 102, 204, 0.35);

    /* ── Transitions ───────────────────────────────────────────────────────── */
    --duration-fast: 150ms;
    --duration-base: 250ms;
    --duration-slow: 400ms;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
    --transition: var(--duration-base) var(--ease-out);

    /* ── Z-Index Scale ─────────────────────────────────────────────────────── */
    --z-negative: -1;
    --z-normal: 1;
    --z-dropdown: 100;
    --z-sticky: 200;
    --z-header: 300;
    --z-overlay: 400;
    --z-modal: 500;
    --z-toast: 600;
  }
</style>
