    --font-size-4xl: 16.03px;

    /* Legacy Type Tokens */
    --text-xs: var(--font-size-xs);
    --text-sm: var(--font-size-sm);
    --text-base: var(--font-size-3xl);
    --text-lg: var(--font-size-4xl);

    /* ── Riitek Spacing Scale ────────────────────────────────────────────────── */
    --space-1: 5px;
    --space-2: 10px;
    --space-3: 12px;
    --space-4: 14px;
    --space-5: 15.36px;
    --space-6: 16px;
    --space-7: 18px;
    --space-8: 20px;

    --sp-1: var(--space-1);
    --sp-2: var(--space-2);
    --sp-3: var(--space-3);
