{%- comment -%}
  MAXWELL DESIGN SYSTEM — CSS VARIABLES & TOKENS
  Injected into <head> via layout/theme.liquid
{%- endcomment -%}

<style>
  :root {
    /* ── Colors ────────────────────────────────────────────────────────────── */
    --color-primary: {{ settings.color_primary | default: '#003366' }};
    --color-primary-dark: #001A33;
    --color-primary-light: #EBF3FA;
    --color-secondary: {{ settings.color_secondary | default: '#0F4C81' }};
    --color-accent: {{ settings.color_accent | default: '#0066CC' }};
    --color-accent-hover: #004C99;
    --color-accent-light: rgba(0, 102, 204, 0.12);
    --color-steel: #64748B;
    --color-steel-light: #F1F5F9;
    --color-bg-page: {{ settings.color_bg | default: '#FFFFFF' }};
    --color-bg-section: {{ settings.color_bg_alt | default: '#F8FAFC' }};
    --color-bg-dark: #001730;
    --color-bg-dark-alt: #000F20;
    --color-text: {{ settings.color_text | default: '#0F172A' }};
    --color-text-muted: {{ settings.color_text_muted | default: '#475569' }};
    --color-text-light: #94A3B8;
    --color-white: #FFFFFF;
    --color-border: #E2E8F0;
    --color-border-dark: rgba(255, 255, 255, 0.14);

    /* ── Typography ────────────────────────────────────────────────────────── */
    --font-heading: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
    --font-weight-extrabold: 800;

    /* Fluid Typography Scale */
    --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.8125rem);
    --text-sm: clamp(0.84rem, 0.8rem + 0.2vw, 0.875rem);
    --text-base: clamp(0.95rem, 0.9rem + 0.25vw, 1rem);
    --text-lg: clamp(1.1rem, 1rem + 0.5vw, 1.125rem);
    --text-xl: clamp(1.25rem, 1.1rem + 0.75vw, 1.25rem);
    --text-2xl: clamp(1.4rem, 1.2rem + 1vw, 1.625rem);
    --text-3xl: clamp(1.75rem, 1.4rem + 1.5vw, 2.25rem);
    --text-4xl: clamp(2.2rem, 1.7rem + 2.2vw, 3rem);
    --text-5xl: clamp(2.8rem, 2rem + 3.5vw, 4rem);

    --leading-tight: 1.15;
    --leading-snug: 1.25;
    --leading-normal: 1.5;
    --leading-relaxed: 1.65;

    --tracking-tight: -0.025em;
    --tracking-normal: 0;
    --tracking-wide: 0.025em;
    --tracking-wider: 0.05em;
    --tracking-widest: 0.1em;

    /* ── Spacing ───────────────────────────────────────────────────────────── */
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-20: 5rem;
    --space-24: 6rem;

    /* ── Layout ────────────────────────────────────────────────────────────── */
    --container-width: {{ settings.container_width | default: 1280 }}px;
    --container-padding: clamp(1.25rem, 4vw, 2.5rem);

    /* ── Border Radius ─────────────────────────────────────────────────────── */
    --radius-xs: 4px;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 14px;
    --radius-xl: 20px;
    --radius-2xl: 28px;
    --radius-full: 9999px;

    /* ── Shadows ───────────────────────────────────────────────────────────── */
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.03);
    --shadow-md: 0 4px 12px -2px rgba(0, 0, 0, 0.06), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    --shadow-lg: 0 10px 25px -3px rgba(0, 0, 0, 0.08), 0 4px 10px -2px rgba(0, 0, 0, 0.04);
    --shadow-xl: 0 20px 40px -4px rgba(0, 51, 102, 0.12), 0 8px 16px -4px rgba(0, 0, 0, 0.04);
    --shadow-2xl: 0 30px 60px -12px rgba(0, 31, 64, 0.25);
    --shadow-glow: 0 0 30px rgba(0, 102, 204, 0.35);

    /* ── Transitions ───────────────────────────────────────────────────────── */
    --duration-fast: 150ms;
    --duration-base: 250ms;
    --duration-slow: 400ms;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
    --transition: var(--duration-base) var(--ease-out);

    /* ── Z-Index Scale ─────────────────────────────────────────────────────── */
    --z-negative: -1;
    --z-normal: 1;
    --z-dropdown: 100;
    --z-sticky: 200;
    --z-header: 300;
    --z-overlay: 400;
    --z-modal: 500;
    --z-toast: 600;
  }
</style>
